      <div class="flex flex-col lg:flex-row gap-12 items-start">
        <div class="lg:w-1/3">
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-brand-blue text-3xl"
              >calendar_month</span
