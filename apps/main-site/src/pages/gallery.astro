---
import MainLayout from "src/layouts/MainLayout.astro";

import "src/styles/global.css";
import { wpFetch } from "@anothersteporg/ui/lib/wp";

const data = await wpFetch(`
  query GetPageByUri {
    page(id: "gallery", idType: URI) {
      title
      featuredVideo {
        embedLink
        videoTitle
        videoSubtitle
        videoCoverImage {
          node {
            sourceUrl
            altText
          }
        }
      }
      galleryItems {
        galleryItems {
          title
          categoryTag
          sizeVariant
          image {
            node {
              sourceUrl
              mediaItemUrl
              altText
            }
          }
        }
      }
    }
  }
`);

const galleryItems = data?.page?.galleryItems?.galleryItems || [];
const featuredVideo = data?.page?.featuredVideo || null;

const getEmbedUrl = (input: string) => {
  if (!input) return "";

  let url = input;
  const iframeSrcMatch = input.match(/src=["']([^"']+)["']/);
  if (iframeSrcMatch && iframeSrcMatch[1]) {
    url = iframeSrcMatch[1];
  }

  const youtubeMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/);
  const vimeoMatch = url.match(/vimeo\.com\/(\d+)/);

  if (youtubeMatch) {
    return `https://www.youtube.com/embed/${youtubeMatch[1]}`;
  }
  
  if (vimeoMatch) {
    return `https://player.vimeo.com/video/${vimeoMatch[1]}`;
  }

  return url;
};

const resolveImageUrl = (imgField: any) => {
  if (!imgField) return "";
  // Check direct URL string, node properties, or root properties
  if (typeof imgField === "string") return imgField;
  const rawUrl = imgField.node?.sourceUrl || imgField.node?.mediaItemUrl || imgField.sourceUrl || imgField.mediaItemUrl || "";
  
  // If WP returns a relative URL, prepend your WP backend base domain
  if (rawUrl.startsWith("/")) {
    const wpBase = import.meta.env.PUBLIC_WORDPRESS_API_URL || "http://localhost:8000";
    return `${wpBase.replace(/\/$/, "")}${rawUrl}`;
  }
  return rawUrl;
};

const getVariantClass = (rawVariant: any) => {
  let value = "";
  if (typeof rawVariant === "string") {
    value = rawVariant;
  } else if (Array.isArray(rawVariant) && rawVariant.length > 0) {
    value = typeof rawVariant[0] === "string" ? rawVariant[0] : rawVariant[0]?.value || "";
  } else if (typeof rawVariant === "object" && rawVariant !== null) {
    value = rawVariant.value || rawVariant.label || "";
  }

  const normalized = value.toLowerCase().trim();

  if (normalized === "tall") return "masonry-item-tall";
  if (normalized === "wide") return "masonry-item-wide";
  return "";
};

const videoEmbedUrl = getEmbedUrl(featuredVideo?.embedLink || "");
const videoCoverImage = resolveImageUrl(featuredVideo?.videoCoverImage);
---

<MainLayout title={data?.page?.title}>
  <!-- Hero Section -->
  <section class="max-w-[1440px] mx-auto px-12 pt-20 pb-12">
    <div class="max-w-3xl">
      <h1
        class="text-[3.5rem] leading-tight font-black text-brand-blue mb-6 font-display"
      >
        Community in Action
      </h1>
      <p
        class="text-body-lg text-on-surface leading-relaxed mb-8 border-l-4 border-brand-yellow-fixed pl-6"
      >
        At Another Step, we believe that true inclusion happens in the heart of
        our neighborhoods. Our participants are active contributors to the
        community, building relationships, developing skills, and discovering
        their passions through authentic, everyday experiences.
      </p>
    </div>
  </section>
  <!-- Video Section -->
  {featuredVideo?.embedLink && (
    <section class="max-w-[1440px] mx-auto px-12 pb-24">
      <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-2xl bg-black">
        {/* If using an embed iframe */}
        <iframe
          src={videoEmbedUrl}
          title={featuredVideo.videoTitle || "Featured Video"}
          class="w-full h-full border-0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </section>
  )}
  <!-- Expanded Photo Grid -->
  <section class="max-w-[1440px] mx-auto px-12 pb-24">
    <h3 class="text-2xl font-bold text-brand-blue mb-8 flex items-center gap-3">
      <span class="material-symbols-outlined">auto_awesome_motion</span>
      Stories of Independence
    </h3>
    <div class="masonry-grid">
      {galleryItems.map((item: any) => {
        const variantClass = getVariantClass(item.sizeVariant);

        const imageUrl = resolveImageUrl(item.image);
        const altText = item.image?.node?.altText || item.title || "Gallery image";

        return (
          <div class={`group relative overflow-hidden rounded-2xl bg-surface-container-low transition-all duration-500 hover:shadow-xl ${variantClass}`}>
            <img
              src={imageUrl}
              alt={altText}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-blue/90 via-brand-blue/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
              <div>
                {item.categoryTag && (
                  <span class="text-label-md uppercase tracking-wider font-bold mb-1 block opacity-80 text-white">
                    {item.categoryTag}
                  </span>
                )}
                <span class="text-white font-bold text-lg">{item.title}</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>
  <!-- Impact Section -->
  <section class="bg-brand-blue text-on-brand-blue py-24 relative overflow-hidden">
    <!-- Decorative circle -->
    <div
      class="absolute -top-24 -right-24 w-96 h-96 bg-brand-blue-container rounded-full opacity-20"
    >
    </div>
    <div
      class="max-w-[1440px] mx-auto px-12 relative z-10 grid md:grid-cols-2 gap-16 items-center"
    >
      <div>
        <h2 class="text-headline-lg font-black mb-6">Every Step Counts</h2>
        <p class="text-body-lg opacity-90 leading-relaxed mb-8">
          The moments captured here are more than just photos; they are the
          milestones of independence. By integrating daily experiences with
          professional coaching and community support, we provide the foundation
          for a fulfilling life where everyone belongs.
        </p>
        <div class="flex gap-4">
          <button
            class="bg-brand-red text-on-brand-red rounded-full px-8 py-3 font-bold active:scale-95 transition-transform hover:shadow-lg"
          >
            Join Our Mission
          </button>
          <button
            class="bg-white/10 backdrop-blur-md border border-white/20 text-white rounded-full px-8 py-3 font-bold hover:bg-white/20 transition-colors"
          >
            Read Impact Stories
          </button>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div
          class="bg-surface-container-lowest/10 backdrop-blur p-8 rounded-2xl border border-white/10 text-center"
        >
          <div class="text-display-lg font-black text-brand-yellow mb-2">
            500+
          </div>
          <div class="text-label-md uppercase tracking-widest font-bold">
            Monthly Outings
          </div>
        </div>
        <div
          class="bg-surface-container-lowest/10 backdrop-blur p-8 rounded-2xl border border-white/10 text-center translate-y-8"
        >
          <div class="text-display-lg font-black text-brand-red-fixed mb-2">
            95%
          </div>
          <div class="text-label-md uppercase tracking-widest font-bold">
            Goal Completion
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
<style>
    .masonry-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        grid-auto-rows: 250px;
        gap: 1.5rem;
    }
    .masonry-item-tall { grid-row: span 2; }
    .masonry-item-wide { grid-column: span 2; }
    @media (max-width: 768px) {
        .masonry-item-wide { grid-column: span 1; }
    }
    .glass-nav {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
    }
</style>