---
import MainLayout from '../layouts/MainLayout.astro';
import BlockResolver from '@anothersteporg/ui/components/BlockResolver.astro';
import Hero from '@anothersteporg/ui/components/Hero.astro';
import AboutSection from 'src/components/AboutSection.astro';
import ValuesSection from 'src/components/ValuesSection.astro';
import EthicsSection from '../components/EthicsSection.astro';
import PublicDisclousre from '../components/PublicDisclosure.astro';
import PromoModal from '@anothersteporg/ui/components/PromoModal.astro';
import '../styles/global.css'

const WP_URL = 'http://host.docker.internal:8050/graphql';

const response = await fetch(WP_URL, {
	method: 'POST',
	headers: { 'Content-Type': 'application/json'},
	body: JSON.stringify({
		query: `
		query GetLatestPromo {
			promos(first: 1, where: { orderby: { field: DATE, order: DESC } }) {
				nodes {
						title
						content
						featuredImage {
							node {
							sourceUrl
							}
						}
					promoFields {
						buttontext
						buttonlink
					}
				}
			}
		}
		`,
	})
});

const homePageResponse = await fetch(WP_URL, {
	method: 'POST',
	headers: {'Content-Type': 'application/json'},
	body: JSON.stringify({
		query: `
			query GetHomePage {
				page(id: "home", idType: URI) {
					homefields {
					heroTitle,
					heroDescription,
					heroImage {
						node {
						sourceUrl
						}
					}
					buttonText1,
					buttonLink1
					buttonText2,
					buttonLink2,
					aboutHeadline,
					aboutContent
					},
					editorBlocks{
					name,
					renderedHtml,
					... on CoreImage {
						attributes {
						url
						alt
						caption
						}
					}
					}
				}
			}
		`,
	})
})

const { data } = await response.json();
const result = await homePageResponse.json();
const homePageData = result.data;
console.log(homePageData.page.editorBlocks[0].name)
const promos = data.promos.nodes[0];

console.log("Blocks found:", homePageData.page.editorBlocks.length);
console.log('DEBUG ACF:', homePageData.page);

// Strip HTML tags from WP content for the modal description
const cleanDescription = promos?.content?.replace(/<[^>]*>?/gm, '') || "";
---
<MainLayout title='Home'>
	{promos && (
		<PromoModal
			id='wp-dynamic-promo'
			title={promos?.title}
			description={cleanDescription}
			buttonText={promos?.promoFields?.buttontext}
			buttonLink={promos?.promoFields?.buttonlink}
			image={promos?.featuredImage?.node?.sourceUrl}
			showDelay={3000}
		/>			
	)}
		<!-- <Hero 
			title='Partnering with People to Create the Lives They Choose'
			subtitle='Another Step, Inc. is dedicated to supporting people with developmental disabilities 
          in fulfilling their potential and exercising control over their lives within their 
          own communities.'
			buttonText='Support Our Mission'
			buttonLink='/donation'
			bgImage='/images/front-page-hero.jpg'
		/> -->
		<BlockResolver blocks={homePageData?.page?.editorBlocks} />
		<AboutSection />
		<ValuesSection />
		<EthicsSection />
		<PublicDisclousre />
</MainLayout>
