---
import MainLayout from "src/layouts/MainLayout.astro";
import BlockResolver from "@anothersteporg/ui/components/BlockResolver.astro";

import "src/styles/global.css";
import { wpFetch, EDITOR_BLOCKS_FRAGMENT } from "@anothersteporg/ui/lib/wp";

const data = await wpFetch(`
  query GetPageByUri {
    page(id: "respite", idType: URI) {
      title
      ${EDITOR_BLOCKS_FRAGMENT}
    }
  }
`)

const blocks = data?.page?.editorBlocks || [];
---

<MainLayout title={data?.page?.title}>
  <BlockResolver blocks={blocks} />
  <section class="bg-surface-container-low py-24">
    <div class="max-w-7xl mx-auto px-8">
      <div
        class="bg-surface-container-lowest rounded-xl p-12 lg:p-16 relative overflow-hidden flex flex-col md:flex-row items-center gap-12"
      >
        <div
          class="w-20 h-20 shrink-0 bg-brand-red rounded-full flex items-center justify-center"
        >
          <span
            class="material-symbols-outlined text-white text-4xl"
            style="font-variation-settings: 'FILL' 1;">info</span
          >
        </div>
        <div>
          <h2 class="text-title-lg font-bold text-brand-red mb-4">
            Important Service Note
          </h2>
          <p
            class="text-2xl lg:text-3xl font-display font-medium text-on-surface leading-tight"
          >
            "In order to receive 24 hour respite service, the caregiver must
            access Site Based Respite, <span class="text-brand-red font-bold"
              >which Another Step does not offer.</span
            >"
          </p>
        </div>
        <!-- Signature Texture/Gradient -->
        <div
          class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-brand-red/10 to-transparent rounded-bl-full"
        >
        </div>
      </div>
    </div>
  </section>
    <!-- Contact Section -->
  <section class="py-24 bg-surface">
    <div class="max-w-screen-2xl mx-auto px-8">
      <div
        class="bg-surface-container p-12 md:p-20 rounded-xl relative overflow-hidden"
      >
        <!-- Background Accent -->
        <div
          class="absolute top-0 right-0 w-1/3 h-full opacity-10 pointer-events-none"
        >
          <svg
            class="h-full w-full"
            viewbox="0 0 200 200"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M44.7,-76.4C58.1,-69.2,69.2,-58.1,76.4,-44.7C83.7,-31.3,87.1,-15.7,87.1,0C87.1,15.7,83.7,31.3,76.4,44.7C69.2,58.1,58.1,69.2,44.7,76.4C31.3,83.7,15.7,87.1,0,87.1C-15.7,87.1,-31.3,83.7,-44.7,76.4C-58.1,69.2,-69.2,58.1,-76.4,44.7C-83.7,31.3,-87.1,15.7,-87.1,0C-87.1,-15.7,-83.7,-31.3,-76.4,-44.7C-69.2,-58.1,-58.1,-69.2,-44.7,-76.4C-31.3,-83.7,-15.7,-87.1,0,-87.1C15.7,-87.1,31.3,-83.7,44.7,-76.4Z"
              fill="#004E8B"
              transform="translate(100 100)"></path>
          </svg>
        </div>
        <div
          class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
        >
          <div>
            <h2
              class="text-[3rem] font-extrabold text-brand-blue leading-tight mb-6"
            >
              Ready to take the next step?
            </h2>
            <p class="text-xl text-on-surface-variant mb-12">
              Connect with our dedicated leadership team to learn more about how
              Community Habilitation can support your journey towards
              independence.
            </p>
            <div class="mt-12 flex gap-4">
              <button class="bg-brand-blue text-on-brand-blue px-10 py-4 rounded-full font-bold text-body-lg shadow-lg hover:bg-brand-blue-container transition-all">Schedule a Call</button>
              <button class="border-2 border-outline-variant px-10 py-4 rounded-full font-bold text-body-lg hover:bg-surface-container-low transition-all">Email Us</button>
            </div>
          </div>
          <div
            class="bg-surface-container-lowest p-10 rounded-xl shadow-xl border-l-8 border-brand-red"
          >
            <div class="flex items-start gap-6">
              <div
                class="w-24 h-24 rounded-full bg-surface-container-high flex-shrink-0 overflow-hidden"
              >
                <img
                  class="w-full h-full object-cover"
                  data-alt="Professional portrait of a male director in business attire, clean grey background, warm friendly expression"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBvx5RiIy6Aq75utWRqRRmXVzGHTTzdNs-QZOwk7jbPOLxiq4erDcTC7HnF8q9bgQy6s6rfA-6pCrG1U0pq4jmU1sNBQdYJCco2hwrw_aIr2-PdeqLV8O6nJuVsrvwESxiYmkTfgvBn5VikdbbWihsBauA3_xuF3akl-Nn0lYrLUFhk4TxuDbGL5sYiEcs9dRfY5bUMGG7adI1k1EwPwONydPu7yapoSN4T3MY9Kd-TuhG2AqVssoGvsbJ7ldPYt-RV5oGyCMYI_wM"
                />
              </div>
              <div>
                <h4 class="text-2xl font-bold text-on-surface">Jaison Jacob</h4>
                <p
                  class="text-brand-red font-medium uppercase tracking-wider text-sm mb-4"
                >
                  Senior Director of Residential Operations, Community Habilition & Respite Services
                </p>
                <div class="space-y-3">
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue"
                      >location_on</span
                    >
                    <span>Rockland &amp; Westchester County</span>
                  </div>
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue"
                      >call</span
                    >
                    <span class="font-bold text-on-surface">(914) 946-2288</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
