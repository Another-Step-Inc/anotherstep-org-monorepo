---
import MainLayout from "src/layouts/MainLayout.astro";
import BlockResolver from "@anothersteporg/ui/components/BlockResolver.astro";

import "src/styles/global.css";
import { wpFetch, EDITOR_BLOCKS_FRAGMENT } from "@anothersteporg/ui/lib/wp";

const data = await wpFetch(`
  query GetPageByUri {
    page(id: "supported-employment", idType: URI) {
      title
      ${EDITOR_BLOCKS_FRAGMENT}
    }
  }
`)

const blocks = data?.page?.editorBlocks || [];
---

<MainLayout title={data?.page?.title}>
  <BlockResolver blocks={blocks} />
  <section class="bg-surface-container-low py-24 px-8">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 text-center max-w-2xl mx-auto">
        <h2
          class="text-headline-lg font-display font-bold text-on-surface mb-4"
        >
          Supportive Pathways
        </h2>
        <p class="text-on-surface-variant">
          We provide comprehensive assistance tailored to individual career
          goals and long-term vocational success.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service Card 1 -->
        <div
          class="bg-surface-container-lowest p-8 rounded-xl editorial-shadow hover:bg-surface-bright transition-colors group"
        >
          <div
            class="w-14 h-14 bg-brand-blue/10 text-brand-blue rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-blue group-hover:text-on-brand-blue transition-all"
          >
            <span
              class="material-symbols-outlined text-[2rem]"
              data-weight="fill">work</span
            >
          </div>
          <h3 class="text-title-lg font-bold text-brand-blue mb-3">
            Job development and placement services
          </h3>
          <p class="text-on-surface-variant leading-relaxed">
            Connecting individuals with opportunities that match their skills,
            interests, and aspirations.
          </p>
        </div>
        <!-- Service Card 2 -->
        <div
          class="bg-surface-container-lowest p-8 rounded-xl editorial-shadow hover:bg-surface-bright transition-colors group"
          style="transform: translateY(0px);"
        >
          <div
            class="w-14 h-14 bg-brand-red/10 text-brand-red rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-red group-hover:text-on-brand-red transition-all"
          >
            <span
              class="material-symbols-outlined text-[2rem]"
              data-weight="fill">analytics</span
            >
          </div>
          <h3 class="text-title-lg font-bold text-brand-red mb-3">
            Job task analysis
          </h3>
          <p class="text-on-surface-variant leading-relaxed">
            Breaking down complex roles into manageable steps to ensure a
            perfect fit for the employee.
          </p>
        </div>
        <!-- Service Card 3 -->
        <div
          class="bg-surface-container-lowest p-8 rounded-xl editorial-shadow hover:bg-surface-bright transition-colors group"
          style="transform: translateY(0px);"
        >
          <div
            class="w-14 h-14 bg-brand-yellow/20 text-brand-dark-yellow rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-dark-yellow group-hover:text-on-brand-yellow transition-all"
          >
            <span
              class="material-symbols-outlined text-[2rem]"
              data-weight="fill">psychology</span
            >
          </div>
          <h3 class="text-title-lg font-bold text-brand-dark-yellow mb-3">
            Job coaching
          </h3>
          <p class="text-on-surface-variant leading-relaxed">
            One-on-one professional mentorship to build confidence and mastery
            in the workplace.
          </p>
        </div>
        <!-- Service Card 4 -->
        <div
          class="bg-surface-container-lowest p-8 rounded-xl editorial-shadow hover:bg-surface-bright transition-colors group"
        >
          <div
            class="w-14 h-14 bg-brand-blue/10 text-brand-blue rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-blue group-hover:text-on-brand-blue transition-all"
          >
            <span
              class="material-symbols-outlined text-[2rem]"
              data-weight="fill">handshake</span
            >
          </div>
          <h3 class="text-title-lg font-bold text-brand-blue mb-3">
            Assistance in dealing with employers
          </h3>
          <p class="text-on-surface-variant leading-relaxed">
            Facilitating clear communication and professional relationships
            between staff and management.
          </p>
        </div>
        <!-- Service Card 5 -->
        <div
          class="bg-surface-container-lowest p-8 rounded-xl editorial-shadow hover:bg-surface-bright transition-colors group"
          style="transform: translateY(0px);"
        >
          <div
            class="w-14 h-14 bg-brand-red/10 text-brand-red rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-red group-hover:text-on-brand-red transition-all"
          >
            <span
              class="material-symbols-outlined text-[2rem]"
              data-weight="fill">verified</span
            >
          </div>
          <h3 class="text-title-lg font-bold text-brand-red mb-3">
            Continued follow up and advocacy
          </h3>
          <p class="text-on-surface-variant leading-relaxed">
            Long-term commitment to employment stability through regular
            check-ins and support.
          </p>
        </div>
        <!-- Service Card 6 -->
        <div
          class="bg-surface-container-lowest p-8 rounded-xl editorial-shadow hover:bg-surface-bright transition-colors group"
          style="transform: translateY(0px);"
        >
          <div
            class="w-14 h-14 bg-brand-yellow/20 text-brand-dark-yellow rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-dark-yellow group-hover:text-on-brand-yellow transition-all"
          >
            <span
              class="material-symbols-outlined text-[2rem]"
              data-weight="fill">receipt_long</span
            >
          </div>
          <h3 class="text-title-lg font-bold text-brand-dark-yellow mb-3">
            Social Security/SSI wage reporting
          </h3>
          <p class="text-on-surface-variant leading-relaxed">
            Professional administrative assistance to ensure all income
            reporting remains compliant and accurate.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Contact Section -->
  <section class="py-24 bg-surface">
    <div class="max-w-screen-2xl mx-auto px-8">
      <div
        class="bg-surface-container p-12 md:p-20 rounded-xl relative overflow-hidden"
      >
        <!-- Background Accent -->
        <div
          class="absolute top-0 right-0 w-1/3 h-full opacity-10 pointer-events-none"
        >
          <svg
            class="h-full w-full"
            viewbox="0 0 200 200"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M44.7,-76.4C58.1,-69.2,69.2,-58.1,76.4,-44.7C83.7,-31.3,87.1,-15.7,87.1,0C87.1,15.7,83.7,31.3,76.4,44.7C69.2,58.1,58.1,69.2,44.7,76.4C31.3,83.7,15.7,87.1,0,87.1C-15.7,87.1,-31.3,83.7,-44.7,76.4C-58.1,69.2,-69.2,58.1,-76.4,44.7C-83.7,31.3,-87.1,15.7,-87.1,0C-87.1,-15.7,-83.7,-31.3,-76.4,-44.7C-69.2,-58.1,-58.1,-69.2,-44.7,-76.4C-31.3,-83.7,-15.7,-87.1,0,-87.1C15.7,-87.1,31.3,-83.7,44.7,-76.4Z"
              fill="#004E8B"
              transform="translate(100 100)"></path>
          </svg>
        </div>
        <div
          class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
        >
          <div>
            <h2
              class="text-[3rem] font-extrabold text-brand-blue leading-tight mb-6"
            >
              Ready to take the next step?
            </h2>
            <p class="text-xl text-on-surface-variant mb-12">
              Connect with our dedicated leadership team to learn more about how
              Community Habilitation can support your journey towards
              independence.
            </p>
            <div class="mt-12 flex gap-4">
              <button class="bg-brand-blue text-on-brand-blue px-10 py-4 rounded-full font-bold text-body-lg shadow-lg hover:bg-brand-blue-container transition-all">Schedule a Call</button>
              <button class="border-2 border-outline-variant px-10 py-4 rounded-full font-bold text-body-lg hover:bg-surface-container-low transition-all">Email Us</button>
            </div>
          </div>
          <div
            class="bg-surface-container-lowest p-10 rounded-xl shadow-xl border-l-8 border-brand-red"
          >
            <div class="flex items-start gap-6">
              <div
                class="w-24 h-24 rounded-full bg-surface-container-high flex-shrink-0 overflow-hidden"
              >
                <img
                  class="w-full h-full object-cover"
                  data-alt="Professional portrait of a male director in business attire, clean grey background, warm friendly expression"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBvx5RiIy6Aq75utWRqRRmXVzGHTTzdNs-QZOwk7jbPOLxiq4erDcTC7HnF8q9bgQy6s6rfA-6pCrG1U0pq4jmU1sNBQdYJCco2hwrw_aIr2-PdeqLV8O6nJuVsrvwESxiYmkTfgvBn5VikdbbWihsBauA3_xuF3akl-Nn0lYrLUFhk4TxuDbGL5sYiEcs9dRfY5bUMGG7adI1k1EwPwONydPu7yapoSN4T3MY9Kd-TuhG2AqVssoGvsbJ7ldPYt-RV5oGyCMYI_wM"
                />
              </div>
              <div>
                <h4 class="text-2xl font-bold text-on-surface">​Ronald Ruphuy</h4>
                <p
                  class="text-brand-red font-medium uppercase tracking-wider text-sm mb-4"
                >
                  Director Supported Employment Services
                </p>
                <div class="space-y-3">
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue"
                      >location_on</span
                    >
                    <span>Rockland &amp; Westchester County</span>
                  </div>
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue"
                      >call</span
                    >
                    <span class="font-bold text-on-surface">(845) 461-3790</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
