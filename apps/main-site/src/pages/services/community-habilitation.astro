---
import MainLayout from "src/layouts/MainLayout.astro";

import "src/styles/global.css";
---

<MainLayout title="Services">
  <!-- Hero Section / Title -->
  <section class="relative pt-20 pb-32 overflow-hidden">
    <div class="max-w-7xl mx-auto px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <span
            class="inline-block px-4 py-1 rounded-full bg-brand-blue-fixed text-on-brand-blue-fixed text-label-md font-bold mb-6"
            >Our Core Services</span
          >
          <h1
            class="text-[3.5rem] leading-[1.1] font-extrabold text-brand-blue mb-8 tracking-tight"
          >
            Community <br />
            <span class="text-brand-dark-red">Habilitation </span>
          </h1>
          <p
            class="text-[1.25rem] leading-relaxed text-on-surface-variant max-w-2xl mb-8"
          >
            Another Step offers personalized supports designed to boost an
            individual's independent living skills at home and enhance their
            community integration. To achieve this, the program provides
            targeted training in self-help, social, communication, and daily
            living skills.
          </p>
        </div>
        <div class="lg:col-span-5 relative">
          <div class="rounded-xl overflow-hidden shadow-2xl rotate-2">
            <img
              alt="Community member smiling in a bright cafe"
              class="w-full h-[500px] object-cover"
              data-alt="A diverse group of adults engaging in a lively conversation inside a modern sunlit library with large windows"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuC2r82GJ7VHlZX74QRGi3AdpX3sJLiHWMOdnKnAJXJG0Ej3G7O75rRm8PsGhIl06fV9F6zwMtAY1m-qbJh59GIHqD5lZwpiek0SKy8NLJiGZGOn7XblDrvqnVbX81lXJEM7bPYldF1zg8XHuwxKIMMagfbRLXCsESCj-sOtSSuEZivn5wsHF_LRK77rSabPMWmkcdDqNSNM3tucZJ4wlr41fDIfdrmBHluAane6bczWyRuP5IB2GUNoE4SmCX4TWVPXmsO1O82uAmU"
            />
          </div>
          <!-- Decorative element -->
          <div
            class="absolute -bottom-6 -left-6 w-32 h-32 bg-brand-yellow rounded-xl -z-10"
          >
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Training Section: Bento Style -->
  <section class="py-24 bg-surface-container-low">
    <div class="max-w-screen-2xl mx-auto px-8">
      <div class="mb-16">
        <h2 class="text-[2.5rem] font-bold text-brand-blue mb-4">
          We provide training to develop and enhance:
        </h2>
        <div class="h-2 w-32 bg-brand-dark-red rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-6 gap-6">
        <!-- Self Help -->
        <div
          class="md:col-span-3 bg-surface-container-lowest p-10 rounded-xl shadow-[0_16px_32px_rgba(0,0,0,0.04)] hover:scale-[1.02] transition-transform flex flex-col justify-between"
        >
          <div>
            <span
              class="material-symbols-outlined text-brand-red text-5xl mb-6"
              data-weight="fill">accessibility_new</span
            >
            <h3 class="text-2xl font-bold mb-4">Self help skills</h3>
            <p class="text-on-surface-variant">
              Fostering personal autonomy through daily living mastery and
              self-care routines tailored to individual needs.
            </p>
          </div>
        </div>
        <!-- Independent Living -->
        <div
          class="md:col-span-3 bg-surface-container-lowest p-10 rounded-xl shadow-[0_16px_32px_rgba(0,0,0,0.04)] hover:scale-[1.02] transition-transform flex flex-col justify-between"
        >
          <div>
            <span
              class="material-symbols-outlined text-brand-blue text-5xl mb-6"
              data-weight="fill">home_work</span
            >
            <h3 class="text-2xl font-bold mb-4">Independent living skills</h3>
            <p class="text-on-surface-variant">
              Building the foundation for a life lived on one's own terms with
              practical household and management training.
            </p>
          </div>
        </div>
        <!-- Community Integration -->
        <div
          class="md:col-span-2 bg-brand-dark-yellow text-on-brand-color p-10 rounded-xl shadow-lg hover:scale-[1.02] transition-transform"
        >
          <span class="material-symbols-outlined text-5xl mb-6">groups</span>
          <h3 class="text-2xl font-bold mb-4">Community integration</h3>
          <p class="opacity-90">
            Meaningful participation in the local neighborhood, connecting with
            peers and public spaces.
          </p>
        </div>
        <!-- Social Skills -->
        <div
          class="md:col-span-2 bg-surface-container-lowest p-10 rounded-xl shadow-[0_16px_32px_rgba(0,0,0,0.04)] hover:scale-[1.02] transition-transform"
        >
          <span
            class="material-symbols-outlined text-brand-blue-container text-5xl mb-6"
            data-weight="fill">forum</span
          >
          <h3 class="text-2xl font-bold mb-4">Social skills</h3>
          <p class="text-on-surface-variant">
            Navigating relationships and social environments with confidence and
            grace.
          </p>
        </div>
        <!-- Communication Skills -->
        <div
          class="md:col-span-2 bg-brand-dark-red text-on-brand-red p-10 rounded-xl shadow-lg hover:scale-[1.02] transition-transform"
        >
          <span class="material-symbols-outlined text-5xl mb-6"
            >record_voice_over</span
          >
          <h3 class="text-2xl font-bold mb-4">Communication skills</h3>
          <p class="opacity-90">
            Developing effective tools for expression and understanding within
            all spheres of life.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Contact Section -->
  <section class="py-24 bg-surface">
    <div class="max-w-screen-2xl mx-auto px-8">
      <div
        class="bg-surface-container p-12 md:p-20 rounded-xl relative overflow-hidden"
      >
        <!-- Background Accent -->
        <div
          class="absolute top-0 right-0 w-1/3 h-full opacity-10 pointer-events-none"
        >
          <svg
            class="h-full w-full"
            viewbox="0 0 200 200"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M44.7,-76.4C58.1,-69.2,69.2,-58.1,76.4,-44.7C83.7,-31.3,87.1,-15.7,87.1,0C87.1,15.7,83.7,31.3,76.4,44.7C69.2,58.1,58.1,69.2,44.7,76.4C31.3,83.7,15.7,87.1,0,87.1C-15.7,87.1,-31.3,83.7,-44.7,76.4C-58.1,69.2,-69.2,58.1,-76.4,44.7C-83.7,31.3,-87.1,15.7,-87.1,0C-87.1,-15.7,-83.7,-31.3,-76.4,-44.7C-69.2,-58.1,-58.1,-69.2,-44.7,-76.4C-31.3,-83.7,-15.7,-87.1,0,-87.1C15.7,-87.1,31.3,-83.7,44.7,-76.4Z"
              fill="#004E8B"
              transform="translate(100 100)"></path>
          </svg>
        </div>
        <div
          class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
        >
          <div>
            <h2
              class="text-[3rem] font-extrabold text-brand-blue leading-tight mb-6"
            >
              Ready to take the next step?
            </h2>
            <p class="text-xl text-on-surface-variant mb-12">
              Connect with our dedicated leadership team to learn more about how
              Community Habilitation can support your journey towards
              independence.
            </p>
            <div class="mt-12 flex gap-4">
              <button class="bg-brand-blue text-on-brand-blue px-10 py-4 rounded-full font-bold text-body-lg shadow-lg hover:bg-brand-blue-container transition-all">Schedule a Call</button>
              <button class="border-2 border-outline-variant px-10 py-4 rounded-full font-bold text-body-lg hover:bg-surface-container-low transition-all">Email Us</button>
            </div>
          </div>
          <div
            class="bg-surface-container-lowest p-10 rounded-xl shadow-xl border-l-8 border-brand-red"
          >
            <div class="flex items-start gap-6">
              <div
                class="w-24 h-24 rounded-full bg-surface-container-high flex-shrink-0 overflow-hidden"
              >
                <img
                  class="w-full h-full object-cover"
                  data-alt="Professional portrait of a male director in business attire, clean grey background, warm friendly expression"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBvx5RiIy6Aq75utWRqRRmXVzGHTTzdNs-QZOwk7jbPOLxiq4erDcTC7HnF8q9bgQy6s6rfA-6pCrG1U0pq4jmU1sNBQdYJCco2hwrw_aIr2-PdeqLV8O6nJuVsrvwESxiYmkTfgvBn5VikdbbWihsBauA3_xuF3akl-Nn0lYrLUFhk4TxuDbGL5sYiEcs9dRfY5bUMGG7adI1k1EwPwONydPu7yapoSN4T3MY9Kd-TuhG2AqVssoGvsbJ7ldPYt-RV5oGyCMYI_wM"
                />
              </div>
              <div>
                <h4 class="text-2xl font-bold text-on-surface">Jaison Jacob</h4>
                <p
                  class="text-brand-red font-medium uppercase tracking-wider text-sm mb-4"
                >
                  Senior Director Residential Operations, Community Habilitation
                  &amp; Respite Services
                </p>
                <div class="space-y-3">
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue"
                      >location_on</span
                    >
                    <span>Rockland &amp; Westchester County</span>
                  </div>
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue"
                      >call</span
                    >
                    <span class="font-bold text-on-surface">(914) 946-2288</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
