        >
          <div class="flex items-start gap-4">
            <span
              class="material-symbols-outlined text-brand-blue text-3xl shrink-0"
              data-weight="fill">fitness_center</span
            >
            <div>
              <h4 class="font-bold text-lg mb-2 text-brand-blue">
                Skill Development
              </h4>
              <p
