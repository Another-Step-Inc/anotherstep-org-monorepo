        >
          <div class="flex items-start gap-4">
            <span
              class="material-symbols-outlined text-brand-blue text-3xl shrink-0"
              data-weight="fill">volunteer_activism</span
            >
            <div>
              <h4 class="font-bold text-lg mb-2 text-brand-blue">
                Staff Skills
              </h4>
              <p
                class="text-on-surface-variant transition-all duration-700 opacity-100 translate-y-0"
              >
                We insure our staff has the skills to meet the needs of people living in the homes.
              </p>
            </div>
          </div>
        </div>
        <!-- Commitment Card 11 -->
        <div
          class="group p-8 rounded-3xl bg-surface hover:bg-surface-container-highest transition-all duration-300 border border-outline-variant/20 hover:border-transparent duration-700 opacity-100 translate-y-0"
        >
          <div class="flex items-start gap-4">
            <span
              class="material-symbols-outlined text-brand-blue text-3xl shrink-0"
              data-weight="fill">psychology</span
            >
            <div>
              <h4 class="font-bold text-lg mb-2 text-brand-blue">
                Behavior Supports
              </h4>
              <p
                class="text-on-surface-variant transition-all duration-700 opacity-100 translate-y-0"
              >
                We provide positive behavior supports to assist people in developing socially appropriate behaviors.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
    <!-- Contact Section -->
  <section class="py-24 bg-surface">
    <div class="max-w-screen-2xl mx-auto px-8">
      <div
        class="bg-surface-container p-12 md:p-20 rounded-xl relative overflow-hidden"
      >
        <!-- Background Accent -->
        <div
          class="absolute top-0 right-0 w-1/3 h-full opacity-10 pointer-events-none"
        >
          <svg
            class="h-full w-full"
