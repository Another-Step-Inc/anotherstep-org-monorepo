---
import MainLayout from "src/layouts/MainLayout.astro";
import BlockResolver from "@anothersteporg/ui/components/BlockResolver.astro";

import "src/styles/global.css";
import { wpFetch, EDITOR_BLOCKS_FRAGMENT } from "@anothersteporg/ui/lib/wp";

const data = await wpFetch(`
  query GetPageByUri {
    page(id: "residences-and-supervised-living", idType: URI) {
      title
      ${EDITOR_BLOCKS_FRAGMENT}
    }
  }
`)

const blocks = data?.page?.editorBlocks || [];
---

<MainLayout title={data?.page?.title}>
  <BlockResolver blocks={blocks} />

  <!-- Secondary Narrative Section -->
  <section class="bg-surface-container-low py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row gap-12 items-start">
        <div class="md:w-1/3">
          <h2
            class="font-display text-4xl font-bold text-brand-blue sticky top-32 transition-all duration-700 opacity-100 translate-y-0"
          >
            Life at Home
          </h2>
        </div>
        <div class="md:w-2/3 space-y-12">
          <div class="space-y-6">
            <p
              class="font-body text-2xl leading-relaxed text-on-surface font-light transition-all duration-700 opacity-100 translate-y-0"
            >
              Another Step involves residents in the day-to-day activities
              associated with living in any home—shopping, cooking, cleaning,
              laundry—while offering a wide range of activities tailored to
              individual interests, both in the home and the community.
            </p>
          </div>
          <!-- Mini Bento Grid for Lifestyle -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div
              class="bg-surface-container-lowest p-8 rounded-3xl editorial-shadow"
            >
              <div
                class="w-12 h-12 bg-primary-container/20 rounded-xl flex items-center justify-center mb-6"
              >
                <span class="material-symbols-outlined text-brand-blue"
                  >local_grocery_store</span
                >
              </div>
              <h3 class="text-xl font-bold text-brand-blue mb-3">
                Community Integration
              </h3>
              <p
                class="text-on-surface-variant transition-all duration-700 opacity-100 translate-y-0"
              >
                Active participation in neighborhood life through local
                shopping, dining, and social events.
              </p>
            </div>
            <div
              class="bg-surface-container-lowest p-8 rounded-3xl editorial-shadow"
            >
              <div
                class="w-12 h-12 bg-secondary-container/20 rounded-xl flex items-center justify-center mb-6"
              >
                <span class="material-symbols-outlined text-secondary"
                  >self_improvement</span
                >
              </div>
              <h3 class="text-xl font-bold text-brand-blue mb-3">
                Skill Building
              </h3>
              <p
                class="text-on-surface-variant transition-all duration-700 opacity-100 translate-y-0"
              >
                Empowering residents through practical home-life education and
                personal independence growth.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
