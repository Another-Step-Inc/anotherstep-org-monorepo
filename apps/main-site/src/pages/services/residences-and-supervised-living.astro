              </p>
            </div>
          </div>
        </div>
        <!-- Commitment Card 5 -->
        <div
          class="group p-8 rounded-3xl bg-surface hover:bg-surface-container-highest transition-all duration-300 border border-outline-variant/20 hover:border-transparent duration-700 opacity-100 translate-y-0"
        >
          <div class="flex items-start gap-4">
            <span
              class="material-symbols-outlined text-brand-blue text-3xl shrink-0"
