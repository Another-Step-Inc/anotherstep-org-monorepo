---
import MainLayout from "src/layouts/MainLayout.astro";
import BlockResolver from "@anothersteporg/ui/components/BlockResolver.astro";

import "src/styles/global.css";
import { wpFetch, EDITOR_BLOCKS_FRAGMENT } from "@anothersteporg/ui/lib/wp";

const data = await wpFetch(`
  query GetPageByUri {
    page(id: "day-habilitation", idType: URI) {
      title
      ${EDITOR_BLOCKS_FRAGMENT}
    }
  }
`)

const blocks = data?.page?.editorBlocks || [];
---

<MainLayout title={data?.page?.title}>
  <BlockResolver blocks={blocks} />
  <!-- Key Points (Bento Grid) -->
  <section class="py-32">
    <div class="max-w-7xl mx-auto px-8">
      <div class="mb-16 text-center max-w-3xl mx-auto">
        <h2 class="text-headline-lg font-bold text-on-surface mb-4">
          The Another Step Experience
        </h2>
        <p class="text-body-lg text-on-surface-variant">
          We've reimagined day services to prioritize independence and personal
          growth through community engagement.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Point 1 -->
        <div
          class="bg-surface-container-lowest p-10 rounded-xl shadow-[0_16px_32px_rgba(0,0,0,0.04)] hover:-translate-y-2 transition-transform border-b-8 border-brand-blue"
        >
          <div
            class="w-16 h-16 rounded-full bg-brand-blue-fixed flex items-center justify-center mb-8"
          >
            <span class="material-symbols-outlined text-brand-blue text-3xl"
              >directions_bus</span
            >
          </div>
          <h3 class="text-title-lg font-bold text-on-surface mb-4">
            Door-to-Door Support
          </h3>
          <p class="text-body-lg text-on-surface-variant leading-relaxed">
            We pick participants up at home in the morning and drop them off at
            the end of the day.
          </p>
        </div>
        <!-- Point 2 -->
        <div
          class="bg-surface-container-lowest p-10 rounded-xl shadow-[0_16px_32px_rgba(0,0,0,0.04)] hover:-translate-y-2 transition-transform border-b-8 border-brand-red"
        >
          <div
            class="w-16 h-16 rounded-full bg-brand-red-fixed flex items-center justify-center mb-8"
          >
            <span class="material-symbols-outlined text-brand-red text-3xl"
              >calendar_today</span
            >
          </div>
          <h3 class="text-title-lg font-bold text-on-surface mb-4">
            Meaningful Schedules
          </h3>
          <p class="text-body-lg text-on-surface-variant leading-relaxed">
            We develop and implement a meaningful schedule of activities based on the participant’s individual preferences and needs tha are delivered 100% in the community.
          </p>
        </div>
        <!-- Point 3 -->
        <div
          class="bg-surface-container-lowest p-10 rounded-xl shadow-[0_16px_32px_rgba(0,0,0,0.04)] hover:-translate-y-2 transition-transform border-b-8 border-brand-dark-yellow"
        >
          <div
            class="w-16 h-16 rounded-full bg-brand-yellow flex items-center justify-center mb-8"
          >
            <span
              class="material-symbols-outlined text-on-brand-yellow text-3xl"
              >volunteer_activism</span
            >
          </div>
          <h3 class="text-title-lg font-bold text-on-surface mb-4">
            Continuous Feedback
          </h3>
          <p class="text-body-lg text-on-surface-variant leading-relaxed">
            We listen to people and make adjustments to the program based on the
            feedback of participants.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Contact Section -->
  <section class="py-24 bg-surface">
    <div class="max-w-screen-2xl mx-auto px-8">
      <div
        class="bg-surface-container p-12 md:p-20 rounded-xl relative overflow-hidden"
      >
        <!-- Background Accent -->
        <div
          class="absolute top-0 right-0 w-1/3 h-full opacity-10 pointer-events-none"
        >
          <svg
            class="h-full w-full"
            viewbox="0 0 200 200"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M44.7,-76.4C58.1,-69.2,69.2,-58.1,76.4,-44.7C83.7,-31.3,87.1,-15.7,87.1,0C87.1,15.7,83.7,31.3,76.4,44.7C69.2,58.1,58.1,69.2,44.7,76.4C31.3,83.7,15.7,87.1,0,87.1C-15.7,87.1,-31.3,83.7,-44.7,76.4C-58.1,69.2,-69.2,58.1,-76.4,44.7C-83.7,31.3,-87.1,15.7,-87.1,0C-87.1,-15.7,-83.7,-31.3,-76.4,-44.7C-69.2,-58.1,-58.1,-69.2,-44.7,-76.4C-31.3,-83.7,-15.7,-87.1,0,-87.1C15.7,-87.1,31.3,-83.7,44.7,-76.4Z"
              fill="#004E8B"
              transform="translate(100 100)"></path>
          </svg>
        </div>
        <div
          class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
        >
          <div>
            <h2
              class="text-[3rem] font-extrabold text-brand-blue leading-tight mb-6"
            >
              Connect with us
            </h2>
            <p class="text-xl text-on-surface-variant mb-12">
              Have questions about our Day Services? Reach out directly to our leadership team for assistance.
            </p>
            <div class="mt-12 flex gap-4">
              <button class="bg-brand-blue text-on-brand-blue px-10 py-4 rounded-full font-bold text-body-lg shadow-lg hover:bg-brand-blue-container transition-all">Schedule a Call</button>
              <button class="border-2 border-outline-variant px-10 py-4 rounded-full font-bold text-body-lg hover:bg-surface-container-low transition-all">Email Us</button>
            </div>
          </div>
          <div
            class="bg-surface-container-lowest p-10 rounded-xl shadow-xl border-l-8 border-brand-red"
          >
            <div class="flex items-start gap-6">
              <div
                class="w-24 h-24 rounded-full bg-surface-container-high flex-shrink-0 overflow-hidden"
              >
                <img
                  class="w-full h-full object-cover"
                  alt="Mary Lattari" 
                  data-alt="Professional portrait of a kind, middle-aged woman with a warm smile, wearing a professional navy blazer in a modern office"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBigPaLRn9BG0RnwmVtVT_QGBACCFNi50Cb7mCCslWCUcsSdi7O34Zd99HiYQcMNMnSCzq-4WnyuRcGtgX_n9N0opwHl11mCRIdoVirOS5itZJpbICbIRcHda9eTmbwUesJzETo5bbZS_w9G3UmtJ2b0KNauLmOGABWabiz7Hn_fXTEh_hi2sx6V2ItojsDuRxcoUbFJFKn7G_4XS6O8M9XYL4JFRE9HbdGINiZxXWcz5629OH7zsnzuZHP49ijqvPIPhbcKxa6hcA"
                />
              </div>
              <div>
                <h4 class="text-2xl font-bold text-on-surface">Mary Lattari</h4>
                <p
                  class="text-brand-red font-medium uppercase tracking-wider text-sm mb-4"
                >
                  Director Day Services
                </p>
                <div class="space-y-3">
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue"
                      >location_on</span
                    >
                    <span>Rockland &amp; Westchester County</span>
                  </div>
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue"
                      >call</span
                    >
                    <span class="font-bold text-on-surface">(914) 946-2288</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
