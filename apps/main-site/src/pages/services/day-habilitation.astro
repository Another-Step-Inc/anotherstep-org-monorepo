---
import MainLayout from "src/layouts/MainLayout.astro";

import "src/styles/global.css";
---

<MainLayout title="Services">
  <!-- Hero Section / Title -->
  <section class="relative pt-20 pb-32 overflow-hidden">
    <div class="max-w-7xl mx-auto px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <span
            class="inline-block px-4 py-1 rounded-full bg-brand-blue-fixed text-on-brand-blue-fixed text-label-md font-bold mb-6"
            >Our Core Services</span
          >
          <h1
            class="text-[3.5rem] leading-[1.1] font-extrabold text-brand-blue mb-8 tracking-tight"
          >
            Day Habilitation <br />
            <span class="text-brand-dark-yellow">(Day Services)</span>
          </h1>
          <p
            class="text-[1.25rem] leading-relaxed text-on-surface-variant max-w-2xl mb-8"
          >
            Another Step offers a unique approach to the provision of day
            supports for people with developmental disabilities. The agency
            provides all-day supports utilizing generic community resources.
          </p>
          <div
            class="flex items-center gap-4 p-4 rounded-xl bg-surface-container-low max-w-lg"
          >
            <span class="material-symbols-outlined text-brand-red text-3xl"
              >domain_disabled</span
            >
            <p class="text-body-lg font-medium text-on-surface">
              There is no “center”, “program site”, or other types of artificial
              setting operated by our agency.
            </p>
          </div>
        </div>
        <div class="lg:col-span-5 relative">
          <div class="rounded-xl overflow-hidden shadow-2xl rotate-2">
            <img
              alt="Community member smiling in a bright cafe"
              class="w-full h-[500px] object-cover"
              data-alt="A diverse group of adults engaging in a lively conversation inside a modern sunlit library with large windows"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuC2r82GJ7VHlZX74QRGi3AdpX3sJLiHWMOdnKnAJXJG0Ej3G7O75rRm8PsGhIl06fV9F6zwMtAY1m-qbJh59GIHqD5lZwpiek0SKy8NLJiGZGOn7XblDrvqnVbX81lXJEM7bPYldF1zg8XHuwxKIMMagfbRLXCsESCj-sOtSSuEZivn5wsHF_LRK77rSabPMWmkcdDqNSNM3tucZJ4wlr41fDIfdrmBHluAane6bczWyRuP5IB2GUNoE4SmCX4TWVPXmsO1O82uAmU"
            />
          </div>
          <!-- Decorative element -->
          <div
            class="absolute -bottom-6 -left-6 w-32 h-32 bg-brand-yellow rounded-xl -z-10"
          >
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
