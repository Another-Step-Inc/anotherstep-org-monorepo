---
// src/pages/news/index.astro
import MainLayout from "src/layouts/MainLayout.astro";

import "src/styles/global.css";

// define WordPress API
const WP_API_URL = "http://host.docker.internal:8050/wp-json/wp/v2";

// fetch the posts (By default gets 10 most recent)
const response = await fetch(`${WP_API_URL}/posts?_embed`);
const posts = await response.json();
---

<MainLayout title="Sector News">
  <!-- Hero Section -->
  <section class="bg-surface-container-low py-20 px-8">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl">
        <h1
          class="text-[3.5rem] leading-[1.1] font-display font-extrabold text-primary mb-6 tracking-tight"
        >
          Sector News
        </h1>
        <p
          class="text-body-lg text-on-surface-variant leading-relaxed opacity-90"
        >
          Stay informed on the latest developments in disability services,
          community initiatives, and the policies that shape an inclusive future
          for everyone.
        </p>
      </div>
    </div>
  </section>
  <!-- Archive Grid -->
  <section class="py-20 px-8 max-w-7xl mx-auto">
    <div class="flex flex-col gap-12">
      <!-- News Card -->
      {
        posts.map((post) => {
          const category = post._embedded?.["wp:term"]?.[0]?.[0];
          const categorySlug = category?.slug || "default";
          const categoryName = category?.name || "News";

          const categoryStyles = {
            "policy-and-advocacy":
              "bg-brand-blue-fixed text-on-brand-blue-fixed-variant",
            "agency-updates":
              "bg-brand-red-fixed text-on-brand-red-fixed-variant text-label-md",
            "community-stories":
              "bg-brand-yellow-fixed text-on-brand-yellow-fixed-variant",
            "resource-and-tools":
              "bg-brand-green-fixed text-on-brand-green-fixed-variant",
            "the-without-walls-perspective":
              "bg-brand-purple-fixed text-on-brand-purple-fixed-variant",
            welcome: "bg-brand-orange-fixed text-on-brand-orange-fixed-variant",
            default:
              "bg-brand-sky-blue-fixed text-on-brand-sky-blue-fixed-variant",
          };

          const badgeClass =
            categoryStyles[categorySlug] || categoryStyles["default"];

          const formattedDate = new Date(post.date).toLocaleDateString(
            "en-US",
            {
              year: "numeric",
              month: "long",
              day: "numeric",
            },
          );
          return (
            <article class="group flex flex-col md:flex-row bg-surface-container-lowest rounded-xl overflow-hidden editorial-shadow transition-transform duration-300 hover:-translate-y-1">
              <div class="aspect-video md:aspect-[4/3] md:w-2/5 bg-surface-container-high overflow-hidden shrink-0">
                <img
                  class="w-full h-full object-cover"
                  data-alt="A professional, bright meeting room where community leaders are discussing disability policy."
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuB0Nf7er-6T3q3pftbhBR0ya0yWjOnatkJvqUTx4QaXzJQhmViZ0ymvLrWplsBCd7i6RVs7t-oSgipPd_C3LkdEGH5yWFv4F2yOMZN6i3iUjhPfkmOYInF_kA_g8HnGjOug8P2bhTcAxmKELKuowS43iaYLCxIQ5Ao7SltMdzFLPT23-wSErr3U0zbnnfGZxnF9PJJzKmV7CvLcgcI8J1rTdOYqj7XJ9QK8ho640VfIaeQN-XlZM4hUSZ0m2AFblN7NVmaPPxWM62Y"
                />
              </div>
              <div class="p-8 md:p-10 flex flex-col justify-center flex-grow">
                {post._embedded?.["wp:term"]?.[0]?.[0] && (
                  <span
                    class={`inline-block px-3 py-1 text-label-md font-bold rounded-full w-fit mb-4 uppercase tracking-wider ${badgeClass}`}
                  >
                    {categoryName}
                  </span>
                )}
                <h2 class="text-headline-sm font-headline font-bold text-on-surface mb-3 group-hover:text-primary transition-colors">
                  <a
                    href={`/news/${post.slug}`}
                    class="hover:text-blue-600"
                    set:html={post.title.rendered}
                  />
                </h2>
                <time class="text-label-md text-outline font-medium mb-4 block">
                  {formattedDate}
                </time>
                <p
                  class="text-body-lg text-on-surface-variant line-clamp-3 mb-6 max-w-2xl"
                  set:html={post.excerpt.rendered}
                />
                <div class="mt-auto">
                  <a
                    class="inline-flex items-center gap-2 text-primary font-bold group-hover:gap-4 transition-all"
                    href={`/news/${post.slug}`}
                  >
                    Read Article
                    <span class="material-symbols-outlined text-[20px]">
                      chevron_right
                    </span>
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
    <!-- Pagination -->
         <nav
    class="mt-20 flex justify-between items-center border-t border-outline-variant/30 pt-10"
  >
    <a
      class="flex items-center gap-3 text-body-lg font-bold text-outline hover:text-primary transition-colors group"
      href="#"
    >
      <span
        class="material-symbols-outlined transition-transform group-hover:-translate-x-1"
        >arrow_back</span
      >
      Newer Posts
    </a>
    <div class="hidden sm:flex gap-4">
      <span
        class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold"
        >1</span
      >
      <a
        class="w-10 h-10 rounded-full hover:bg-surface-container-high flex items-center justify-center font-bold text-on-surface-variant transition-colors"
        href="#">2</a
      >
      <a
        class="w-10 h-10 rounded-full hover:bg-surface-container-high flex items-center justify-center font-bold text-on-surface-variant transition-colors"
        href="#">3</a
      >
    </div>
    <a
      class="flex items-center gap-3 text-body-lg font-bold text-primary hover:text-primary-container transition-colors group"
      href="#"
    >
      Older Posts
      <span
        class="material-symbols-outlined transition-transform group-hover:translate-x-1"
        >arrow_forward</span
      >
    </a>
  </nav>
  </section>
  
  <section class="bg-surface-container-low py-20 px-8 mb-20">
    <div class="max-w-4xl mx-auto space-y-16">
      <!-- Diversity & Inclusion Statement -->
      <div class="space-y-6 text-center md:text-left">
        <h2
          class="text-[2.5rem] font-display font-extrabold text-primary leading-tight"
        >
          Diversity &amp; Inclusion Statement
        </h2>
        <div class="space-y-4">
          <p class="text-body-lg text-on-surface-variant leading-relaxed">
            Consistent with our mission to partner with developmentally disabled
            individuals to create the lives they choose, we partner with black,
            indigenous, and people of all colors in the fight against systemic
            racism and social injustice. Our organization has a proud history of
            employing and servicing people of various races and cultural
            backgrounds.
          </p>
          <p
            class="text-body-lg text-on-surface-variant leading-relaxed font-semibold"
          >
            We are committed to a society that is diverse, inclusive, tolerant,
            and respectful. Another Step will continue to consciously work
            together to support one another and our developmentally disabled
            community, especially in times when it is needed most.
          </p>
          <p
            class="text-headline-sm font-bold text-primary italic uppercase tracking-wide"
          >
            We stand against racism! We stand for inclusion!
          </p>
        </div>
      </div>
      <!-- Support Resources -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-12 pt-12 border-t border-outline-variant/30"
      >
        <div class="space-y-4">
          <h3 class="text-headline-md font-display font-bold text-on-surface">
            Support Resources
          </h3>
          <p class="text-body-lg text-on-surface-variant leading-relaxed">
            Another Step, Inc. cares about the needs of our staff and families.
            If you are feeling overwhelmed, please reach out to the resources
            available. You do not need to go through this alone.
          </p>
        </div>
        <!-- Helpline Call-out -->
        <div class="bg-primary text-on-primary p-8 rounded-xl editorial-shadow">
          <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-outlined text-3xl"
              >health_and_safety</span
            >
            <h4 class="text-title-lg font-bold">Mental Health Helpline</h4>
          </div>
          <p class="text-[1.75rem] font-display font-black mb-4">
            1-844-863-9314
          </p>
          <p class="text-on-primary/90 text-label-lg leading-relaxed">
            The New York State Mental Health Helpline is staffed by trained
            volunteers who are there to listen and provide support when you need
            it most.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
