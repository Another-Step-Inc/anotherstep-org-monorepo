---
import MainLayout from "src/layouts/MainLayout.astro";
import BlockResolver from "@anothersteporg/ui/components/BlockResolver.astro";

import "src/styles/global.css";
import { wpFetch, EDITOR_BLOCKS_FRAGMENT } from '@anothersteporg/ui/lib/wp.js';

const data = await wpFetch(`
  query GetPageByUri {
    page(id: "about-us", idType: URI) {
      title
      ${EDITOR_BLOCKS_FRAGMENT}
    }
  }
`)

const blocks = data?.page?.editorBlocks || [];
---

<MainLayout title={data?.page?.title}>
  <BlockResolver blocks={blocks} />
  <section class="bg-brand-bg py-24">
    <div class="max-w-7xl mx-auto px-8">
      <div class="flex flex-col md:flex-row gap-12 items-start">
        <div class="md:w-1/3">
          <h2
            class="text-3xl font-black text-brand-blue uppercase tracking-widest mb-4"
          >
            Our Mission
          </h2>
          <div class="h-2 w-24 bg-brand-dark-yellow rounded-full"></div>
        </div>
        <div class="md:w-2/3">
          <p class="text-2xl text-on-surface font-light leading-snug mb-8">
            <div class="space-y-8 mb-12">
              <p class="text-3xl font-black text-brand-blue leading-tight">
                Another Step partners with people with developmental
                disabilities to create the lives they choose.
              </p>
              <p class="text-xl text-on-surface-variant leading-relaxed">
                To this end, Another Step provides both alternative and
                traditional services through the use of person-centered
                approaches that build individualized systems of support.
              </p>
              <div
                class="pullquote border-l-4 border-brand-yellow pl-6 space-y-4"
              >
                <p
                  class="text-lg text-on-surface-variant leading-relaxed font-medium"
                >
                  The best opportunities for people with developmental
                  disabilities to fulfill their potential, as well as exercise
                  control over their lives, occur naturally in their communities
                  and neighborhoods.
                </p>
                <p
                  class="text-lg text-on-surface-variant leading-relaxed font-medium"
                >
                  Another Step fully engages people with developmental
                  disabilities in their communities by supporting them in
                  integrated housing, volunteer work, and recreational
                  experiences.
                </p>
              </div>
              <p class="text-xl text-on-surface-variant leading-relaxed pt-4">
                At Another Step, we are convinced that creative, consumer-driven
                approaches, provide the best quality of life for all people with
                intellectual and developmental disabilities.
              </p>
            </div>
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-2xl flex flex-col gap-4">
              <span
                class="material-symbols-outlined text-brand-blue text-4xl"
                data-icon="auto_awesome">auto_awesome</span
              >
              <h3 class="text-xl font-bold text-brand-blue">Clarity First</h3>
              <p>
                We strip away the jargon to provide clear, actionable guidance
                that anyone can follow.
              </p>
            </div>
            <div class="bg-white p-8 rounded-2xl flex flex-col gap-4">
              <span
                class="material-symbols-outlined text-brand-red text-4xl"
                data-icon="favorite">favorite</span
              >
              <h3 class="text-xl font-bold text-brand-red">
                Radical Inculsion
              </h3>
              <p>
                Accessibility isn't a feature; it's our foundation. We design
                for every ability from day one.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-8 py-24">
    <div class="mb-16">
      <h2 class="text-4xl font-black text-on-surface mb-4">Who We Support</h2>
      <p class="text-lg text-on-surface-variant max-w-2xl">
        Another Step is built for anyone who feels stuck, overwhelmed, or
        overlooked by traditional systems.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Large Feature -->
      <div
        class="md:col-span-2 bg-primary rounded-[2rem] p-10 text-on-primary flex flex-col justify-between min-h-[400px]"
      >
        <div>
          <span
            class="material-symbols-outlined text-5xl mb-6"
            data-icon="school">school</span
          >
          <h3 class="text-3xl font-bold mb-4">
            Students &amp; Lifelong Learners
          </h3>
          <ul class="space-y-4 text-lg opacity-90">
            <li class="flex items-start gap-3">
              <span
                class="material-symbols-outlined text-tertiary-fixed"
                data-icon="check_circle"
                style="font-variation-settings: 'FILL' 1;">check_circle</span
              >
              Navigating complex educational transitions.
            </li>
            <li class="flex items-start gap-3">
              <span
                class="material-symbols-outlined text-tertiary-fixed"
                data-icon="check_circle"
                style="font-variation-settings: 'FILL' 1;">check_circle</span
              >
              Finding inclusive resources for neurodivergent minds.
            </li>
            <li class="flex items-start gap-3">
              <span
                class="material-symbols-outlined text-tertiary-fixed"
                data-icon="check_circle"
                style="font-variation-settings: 'FILL' 1;">check_circle</span
              >
              Breaking down career paths into simple steps.
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <button
            class="bg-white text-brand-blue px-8 py-4 rounded-full font-bold hover:bg-brand-blue-fixed transition-colors"
            >Learn More</button
          >
        </div>
      </div>
      <!-- Side Feature 1 -->
      <div class="bg-surface-container-high rounded-[2rem] p-8 flex flex-col">
        <span
          class="material-symbols-outlined text-secondary text-4xl mb-6"
          data-icon="work_history">work_history</span
        >
        <h3 class="text-2xl font-bold text-on-surface mb-4">Career Changers</h3>
        <p class="text-on-surface-variant mb-6">
          For those pivotting to new industries or returning to the workforce
          after a break.
        </p>
        <div class="mt-auto h-32 w-full rounded-xl overflow-hidden">
          <img
            alt="Collaborative workspace"
            class="w-full h-full object-cover"
            data-alt="Close up of diverse hands working together on a bright table with colorful notes and laptops"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDPYFUtOQbCIRksxgdL7nnoChqmPszcHG9-CZUFAU5_XjIADre0awLShzkvCpnKZ7WfxQA01bcAJJHbtR38_4fsPCNeRYfsaBoCdHCVQnHDnP_7nPAWEzr7JaEca9YNVBROPg6pbRaBgAuJ_Sug52IqpNMF26IqEWmq3Gx7nEh5aAedQDfnWosCv6fhtzqUeeJ6r6NjEKV5NhccK_v_9GRz6U6dEPPDsjv6Ok2v8EDa1GVhyfTdMa8z6SVYnpIMF3bM6XAhouy21vM"
          />
        </div>
      </div>
      <!-- Side Feature 2 -->
      <div
        class="bg-brand-dark-yellow rounded-[2rem] p-8 flex flex-col text-brand-yellow-fixed"
      >
        <span
          class="material-symbols-outlined text-4xl mb-6"
          data-icon="home_health">home_health</span
        >
        <h3 class="text-2xl font-bold mb-4">Community Seekers</h3>
        <p class="opacity-90 mb-6">
          Helping individuals find local support networks and accessible social
          services without the stress.
        </p>
        <div class="mt-auto flex -space-x-4">
          <div
            class="w-12 h-12 rounded-full border-4 border-brand-dark-yellow bg-slate-300 overflow-hidden"
          >
            <img
              alt="User"
              data-alt="Portrait of a friendly man"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBGjWEjFd_-EoT_aD2BH6YOhcvIM5O8l0wSDZjjgyX0rkPCSjss7iW9S9Xk_CcU18Z55dnvtQdB_wh6RMJHvdfwnY_58XnWhhXGwoqJDd9X5vMy3ZUqc7h7WliOU8YqMTP-NwVtxOim2eQXH5mMo7rL9eR8Ah-vFMicQkBs2rKwrrZ51LXaoxEkQLOEfsFXqpZuSpQ9T0bJpIHyhLxRZt5dwjBFQeLpHeGzFy2xOisGkZThxj6fGvXA7FmvX83CV2rv4QqV4V-Tcro"
            />
          </div>
          <div
            class="w-12 h-12 rounded-full border-4 border-brand-dark-yellow bg-slate-400 overflow-hidden"
          >
            <img
              alt="User"
              data-alt="Portrait of a smiling woman"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAKNNMxDP1pyd4Nq9cW62Gz6-Oni2GwYGUCSbWPjJQldzyhUTLYYDXXZEf4H5I7ClFA34IWiqaYouQ2G7HXjBPywAsQrZYP4VRgMolTgPv30fgiCxlY6rdlohhFD8L5iTuRHW6TX7yzl2kGd8-byBjQsOsRNTH1A3FYxpBfAar44iVlxSI9eKUsP1IMlOSnB_YO_ukEJJTCynHTekvf2ed_8N-RtZPLnsQ5LyKoMwYrceQ3G_ROEDRBp3AFrzqUGOOhZjgYk9i8R4M"
            />
          </div>
          <div
            class="w-12 h-12 rounded-full border-4 border-brand-dark-yellow bg-slate-500 overflow-hidden"
          >
            <img
              alt="User"
              data-alt="Portrait of a professional man"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBEatjuJ50GqzQXVOpPsUOYmnZqc4eY3W39hj4qHKZN-TcTz0cT9pI6O-MRGrDWYkLn_bH-vj1FaFS6Z5yFvUue8F4SOe3g2xGiv6Erj6Fj0-Fpongc7TxWsbtVc82_Hj7cDUpuIPUr5VPhOvYGKe1vlJNHnD2Z9bA7uOy2aP6PwtlBDJMgNcLCnUhhZzKGqp-w4V--ANws-bkifFVDc-Q9YKJLChilG8_nUGEnuIvEH5u7u5F3R84_r9b7ZlBm2Z1p46M4Vf_w-X8"
            />
          </div>
        </div>
      </div>
      <!-- Wide Bottom Feature -->
      <div
        class="md:col-span-2 bg-surface-container-lowest border border-outline-variant/20 rounded-[2rem] p-10 flex flex-col md:flex-row gap-10"
      >
        <div class="md:w-1/2">
          <h3 class="text-3xl font-bold text-on-surface mb-4">Why We Do It</h3>
          <p class="text-on-surface leading-relaxed">
            The world is full of "dead ends"—complex forms, unclear
            instructions, and inaccessible designs. We exist to replace those
            dead ends with open doors.
          </p>
        </div>
        <div class="md:w-1/2 flex flex-col gap-4">
          <div
            class="flex items-center gap-4 p-4 rounded-xl bg-surface-container"
          >
            <span
              class="material-symbols-outlined text-brand-blue"
              data-icon="verified"
              style="font-variation-settings: 'FILL' 1;">verified</span
            >
            <span class="font-bold">Over 500+ Resource Guides</span>
          </div>
          <div
            class="flex items-center gap-4 p-4 rounded-xl bg-surface-container"
          >
            <span
              class="material-symbols-outlined text-brand-blue"
              data-icon="group_add"
              style="font-variation-settings: 'FILL' 1;">group_add</span
            >
            <span class="font-bold">Active in 45 Local Communities</span>
          </div>
          <div
            class="flex items-center gap-4 p-4 rounded-xl bg-surface-container"
          >
            <span
              class="material-symbols-outlined text-brand-blue"
              data-icon="forum"
              style="font-variation-settings: 'FILL' 1;">forum</span
            >
            <span class="font-bold">24/7 Peer Support Chat</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-8 py-24 border-t-0 text-center">
    <h2 class="text-4xl md:text-5xl font-black text-brand-blue mb-12">
      The Journey Forward
    </h2>
    <div class="flex flex-col md:flex-row items-center justify-center gap-4">
      <div
        class="w-full md:w-64 h-32 bg-brand-blue rounded-2xl flex flex-col items-center justify-center text-on-primary p-4 shadow-lg"
      >
        <span class="text-4xl font-black mb-1">01</span>
        <span class="text-sm font-bold uppercase tracking-widest">Identify</span
        >
      </div>
      <div
        class="hidden md:block w-12 h-2 bg-surface-container-highest rounded-full"
      >
      </div>
      <div
        class="w-full md:w-64 h-32 bg-brand-red rounded-2xl flex flex-col items-center justify-center text-on-secondary p-4 shadow-lg"
      >
        <span class="text-4xl font-black mb-1">02</span>
        <span class="text-sm font-bold uppercase tracking-widest"
          >Strategize</span
        >
      </div>
      <div
        class="hidden md:block w-12 h-2 bg-surface-container-highest rounded-full"
      >
      </div>
      <div
        class="w-full md:w-64 h-32 bg-brand-yellow text-on-tertiary-fixed rounded-2xl flex flex-col items-center justify-center p-4 shadow-lg"
      >
        <span class="text-4xl font-black mb-1">03</span>
        <span class="text-sm font-bold uppercase tracking-widest">Succeed</span>
      </div>
    </div>
  </section>
  <!-- CTA Section -->
  <section class="max-w-7xl mx-auto px-8 py-20">
    <div
      class="bg-brand-blue rounded-[3rem] p-12 md:p-20 text-center relative overflow-hidden"
    >
      <div
        class="absolute inset-0 bg-gradient-to-br from-brand-blue via-brand-blue to-brand-blue-container"
      >
      </div>
      <div class="relative z-10 space-y-8">
        <h2 class="text-4xl md:text-6xl font-black text-white leading-tight">
          Ready for your next step?
        </h2>
        <p
          class="text-xl md:text-2xl text-on-blue-container max-w-2xl mx-auto opacity-90"
        >
          Join our community today and discover how simple progress can be when
          you have the right support.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center pt-6">
          <button
            class="bg-brand-yellow text-on-tertiary-fixed px-10 py-5 rounded-full font-black text-xl shadow-lg hover:scale-105 transition-all"
            >Join the Movement</button
          >
          <button
            class="bg-white text-brand-blue px-10 py-5 rounded-full font-black text-xl shadow-sm hover:bg-surface-container-high transition-all"
            >Contact Us</button
          >
        </div>
      </div>
    </div>
  </section>
</MainLayout>
