---
import MainLayout from '../layouts/MainLayout.astro';

import '../styles/global.css'
---
<MainLayout title="About Us">
    <div class="page-wrapper">
            <div class="flex flex-row">
                <div class="w-1/2">
                    <h1 class="text-[42pt] text-brand-blue">Moving Forward, Together.</h1>
                    <p class="text-[16pt] text-brand-text w-150">Another Step is more than an organization. We are a supportive path for individuals navigating life transitions, dedicated to making progress accessible for everyone.</p>
                    <div class="flex flex-wrap gap-4">
                        <div class="flex items-center gap-3 bg-tertiary-fixed text-on-tertiary-fixed px-6 py-4 rounded-xl font-bold">
                            <span class="material-symbols-outlined" data-icon="diversity_3">diversity_3</span>
                            Inclusive Community
                        </div>
                        <div class="flex items-center gap-3 bg-secondary-fixed text-on-secondary-fixed px-6 py-4 rounded-xl font-bold">
                            <span class="material-symbols-outlined" data-icon="accessibility_new">accessibility_new</span>
                            AAA Accessible
                        </div>
                    </div>
                </div>
                <div class="w-1/2 relative flex items-center justify-center">
                    <div class="aspect-square rounded-3xl shadow-2xl relative rotate-3 w-95 h-95">
                        <div class="w-full h-full rounded-3xl overflow-hidden">
                            <img class="w-full h-full object-cover" src="/images/about-main-image.png" alt="" />
                        </div>
                    </div>
                    <div class="absolute -bottom-3 left-1 w-2/5 h-auto bg-white p-6 rounded-2xl shadow-xl flex flex-col justify-center z-20">
                        <span class="text-brand-red font-black text-2xl block mb-1">12k+</span>
                        <p class="text-on-surface-variant font-medium text-xs">Individuals supported through their next big step this year.</p>
                    </div>
                </div>
                
            </div>
    </div>
</MainLayout>