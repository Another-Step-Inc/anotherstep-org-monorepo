---
import MainLayout from "src/layouts/MainLayout.astro";
import BlockResolver from "@anothersteporg/ui/components/BlockResolver.astro";

import "src/styles/global.css";
import { wpFetch, EDITOR_BLOCKS_FRAGMENT } from '@anothersteporg/ui/lib/wp.js';

const data = await wpFetch(`
  query GetPageByUri {
    page(id: "crayola-flowers-fundraiser", idType: URI) {
      title
      ${EDITOR_BLOCKS_FRAGMENT}
    }
  }
`)

const blocks = data?.page?.editorBlocks || [];
---

<MainLayout title={data?.page?.title}>
  <BlockResolver blocks={blocks} />
  <!-- Partner Feature (Bento Style) -->
  <section class="py-24 bg-surface-container-low relative">
    <div class="absolute inset-0 flower-accent"></div>
    <div class="max-w-7xl mx-auto px-8 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-stretch">
        <!-- Partnership Intro -->
        <div
          class="md:col-span-7 bg-surface-container-lowest p-12 rounded-[2rem] editorial-shadow flex flex-col justify-center"
        >
          <div class="mb-8 h-24 flex items-center">
            <img
              alt=""
              class="h-full object-contain"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCjnrC4AQasqitS10CQk3H1yojVXOXAIqqfxA75BMCz11s6TmqrCa6X9ZdpcSG4mfuPHmJbi8ty1QpzPFgumKXYrrfQLohkq-YO0kSgKAF_-FSYCtKCIilVvvjqLkFuNeVr1HmA2EvdmUK5PhHjWiDGetHEbnGfEvq5x0KVk-7j70g52AkLVpV8MgQqh89na6aQsjJLxWiR3G9iz70zQbrHAVznZ6Ku5rcWgcwuSxxWn5OGVBd8X4uxDlVa8kDV8CUaPkMbsbPGeP0"
            />
          </div>
          <h2 class="text-headline-lg font-black text-on-surface mb-6">
            A Colorful Collaboration
          </h2>
          <p class="text-body-lg text-on-surface-variant leading-relaxed">
            Another Step is proud to partner with Crayola Flowers. This unique
            initiative allows you to send stunning, premium floral arrangements
            while giving back. For every bouquet sold through our dedicated
            link, a significant portion of the proceeds goes directly to
            supporting our mission of empowering individuals with intellectual
            and developmental disabilities.
          </p>
        </div>
        <!-- Impact Card -->
        <div
          class="md:col-span-5 bg-brand-blue-container text-on-brand-blue p-12 rounded-[2rem] editorial-shadow flex flex-col justify-between"
        >
          <div>
            <span
              class="material-symbols-outlined text-5xl mb-6"
              style="font-variation-settings: 'FILL' 1;"
              >volunteer_activism</span
            >
            <h3 class="text-headline-lg font-black leading-tight mb-4">
              Every Purchase Matters
            </h3>
          </div>
          <p class="text-on-brand-blue/90 text-lg">
            Your gift does more than beautify a room—it builds a bridge to
            independence. Proceeds fund vocational training, residential
            support, and community integration initiatives.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- How It Works (Signature Step Blocks) -->
  <section class="py-24 bg-surface" id="how-it-works">
    <div class="max-w-7xl mx-auto px-8">
      <div class="mb-16 text-center max-w-2xl mx-auto">
        <h2 class="text-headline-lg font-black text-brand-blue mb-4">
          Three Simple Steps
        </h2>
        <p class="text-body-lg text-on-surface-variant">
          Bringing color to our community is easy. Follow this simple path to
          make a difference.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <!-- Step 1 -->
        <div class="relative group">
          <div
            class="w-20 h-20 bg-brand-blue-container text-on-blue-container rounded-3xl flex items-center justify-center mb-8 rotate-3 group-hover:rotate-0 transition-transform duration-300"
          >
            <span class="text-3xl font-black">01</span>
          </div>
          <h3 class="text-title-lg font-black mb-4">Visit Our Shop</h3>
          <p class="text-on-surface-variant leading-relaxed">
            Click the button above to go to the official Crayola Flowers
            fundraising page dedicated to Another Step.
          </p>
          <div
            class="h-2 w-full bg-surface-container-high rounded-full mt-8 overflow-hidden"
          >
            <div class="h-full bg-brand-blue w-1/3"></div>
          </div>
        </div>
        <!-- Step 2 -->
        <div class="relative group">
          <div
            class="w-20 h-20 bg-brand-dark-red text-on-brand-red rounded-3xl flex items-center justify-center mb-8 -rotate-3 group-hover:rotate-0 transition-transform duration-300"
          >
            <span class="text-3xl font-black">02</span>
          </div>
          <h3 class="text-title-lg font-black mb-4">Choose a Bouquet</h3>
          <p class="text-on-surface-variant leading-relaxed">
            Select from a wide variety of vibrant, high-quality floral
            arrangements for any occasion or just because.
          </p>
          <div
            class="h-2 w-full bg-surface-container-high rounded-full mt-8 overflow-hidden"
          >
            <div class="h-full bg-brand-dark-red w-2/3"></div>
          </div>
        </div>
        <!-- Step 3 -->
        <div class="relative group">
          <div
            class="w-20 h-20 bg-brand-dark-yellow text-on-brand-yellow rounded-3xl flex items-center justify-center mb-8 rotate-6 group-hover:rotate-0 transition-transform duration-300"
          >
            <span class="text-3xl font-black">03</span>
          </div>
          <h3 class="text-title-lg font-black mb-4">Spread the Joy</h3>
          <p class="text-on-surface-variant leading-relaxed">
            Complete your purchase. The flowers are delivered, and a portion of
            your sale is donated to our programs.
          </p>
          <div
            class="h-2 w-full bg-surface-container-high rounded-full mt-8 overflow-hidden"
          >
            <div class="h-full bg-brand-dark-yellow w-full"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Contact Section -->
  <section class="py-24 bg-surface-container-highest">
    <div class="max-w-7xl mx-auto px-8">
      <div
        class="bg-surface-container-lowest rounded-[3rem] p-12 md:p-20 overflow-hidden relative editorial-shadow"
      >
        <div class="absolute top-0 right-0 w-64 h-64 opacity-10 -mr-20 -mt-20">
          <span
            class="material-symbols-outlined text-[20rem] text-brand-blue"
            style="font-variation-settings: 'FILL' 1;">local_florist</span
          >
        </div>
        <div
          class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-16 items-center"
        >
          <div>
            <h2 class="text-display-lg font-black text-brand-blue mb-6">
              Have questions about our fundraiser?
            </h2>
            <p class="text-body-lg text-on-surface-variant mb-8 max-w-md">
              We're here to help you navigate your purchase or explain more
              about how your contribution impacts our community.
            </p>
          </div>
          <div class="space-y-8">
            <div
              class="flex items-center gap-6 p-6 bg-surface-container-low rounded-2xl border border-outline-variant/10"
            >
              <div
                class="w-16 h-16 bg-brand-blue/10 text-brand-blue rounded-full flex items-center justify-center shrink-0"
              >
                <span class="material-symbols-outlined text-3xl">call</span>
              </div>
              <div>
                <p
                  class="text-label-md font-bold uppercase tracking-widest text-outline"
                >
                  Call Us
                </p>
                <a
                  class="text-title-lg font-black text-on-surface hover:text-brand-blue transition-colors"
                  href="tel:8452688200, , ,129">845-268-8200​ext. 129</a
                >
              </div>
            </div>
            <div
              class="flex items-center gap-6 p-6 bg-surface-container-low rounded-2xl border border-outline-variant/10"
            >
              <div
                class="w-16 h-16 bg-brand-blue/10 text-brand-blue rounded-full flex items-center justify-center shrink-0"
              >
                <span class="material-symbols-outlined text-3xl">mail</span>
              </div>
              <div>
                <p
                  class="text-label-md font-bold uppercase tracking-widest text-outline"
                >
                  Email Marjorie Watson Ley
                </p>
                <a
                  class="text-title-lg font-black text-on-surface hover:text-primary transition-colors"
                  href="mailto:mwatsonley@anotherstep.org">mwatsonley@anotherstep.org</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
<style is:global>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .flower-accent {
            background-image: radial-gradient(circle at 10px 10px, #bb0014 2px, transparent 0);
            background-size: 32px 32px;
            opacity: 0.05;
        }
        .editorial-shadow {
            box-shadow: 0 16px 32px -8px rgba(26, 28, 30, 0.04);
        }
</style>