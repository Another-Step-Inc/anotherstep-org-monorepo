---
import MainLayout from '../layouts/MainLayout.astro';

import '../styles/global.css'
---
<MainLayout title="Contact Us">
    <div class="page-wrapper">
        <div class="page-hero flex flex-row">
            <div class="hero-text">
                <h1 class="text-[42pt] text-brand-blue">We're here to help you take the <span class="text-brand-red">next step</span>.</h1>
                <p class="text-[16pt] text-brand-text w-150">Whether you have a question about our services or need immediate assistance, our team is ready to support you with warmth and clarity.</p>
            </div>
            <img class="rounded-[15px] w-130" src="/images/contact-main-image.png" alt="" />
        </div>
        <div class="page-content flex flex-row">

        </div>
    </div>
</MainLayout>