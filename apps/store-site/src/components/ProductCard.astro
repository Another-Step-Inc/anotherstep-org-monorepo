---
// apps/store-site/src/components/ProductCard.astro
---
<div class="group cursor-pointer">
  <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-[#EEEEEE] relative mb-4">
    <img 
      src="/product-photo.jpg" 
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
      alt="Product Name"
    />
    <div class="absolute bottom-4 left-4">
      <span class="bg-[#EC1F28] text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest shadow-lg">
        Supports Community
      </span>
    </div>
  </div>

  <div class="space-y-1 px-1">
    <h3 class="text-[#232020] font-bold text-lg group-hover:text-[#0E75BC] transition-colors">
      Official Logo Hoodie
    </h3>
    <p class="text-[#808080] text-sm uppercase tracking-wider font-medium">Apparel</p>
    <div class="flex items-center gap-3 pt-2">
      <span class="text-[#232020] font-black text-xl">$45.00</span>
      <span class="text-[#808080] text-sm line-through opacity-50">$55.00</span>
    </div>
  </div>
</div>