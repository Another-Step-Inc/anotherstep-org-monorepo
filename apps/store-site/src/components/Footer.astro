---
// apps/store-site/src/components/Footer.astro
---
<footer class="bg-[#232020] text-[#EEEEEE] py-12 px-6 mt-20 rounded-t-[3rem]">
  <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-12">
    <div>
      <h4 class="text-[#F9EF21] font-bold mb-4 uppercase tracking-widest text-sm">Store Information</h4>
      <p class="text-[#A9A9A9] text-sm leading-relaxed">
        Proceeds from the Another Step store directly fund our community-based programs for individuals with developmental disabilities.
      </p>
    </div>
    
    <div>
      <h4 class="text-[#F9EF21] font-bold mb-4 uppercase tracking-widest text-sm">Customer Care</h4>
      <ul class="space-y-2 text-sm text-[#A9A9A9]">
        <li><a href="#" class="hover:text-[#0E75BC]">Shipping Policy</a></li>
        <li><a href="#" class="hover:text-[#0E75BC]">Returns</a></li>
        <li><a href="#" class="hover:text-[#0E75BC]">Contact Support</a></li>
      </ul>
    </div>

    <div>
      <p class="text-[10px] text-[#808080] uppercase tracking-widest border-t border-[#808080]/30 pt-4">
        © 2026 Another Step, Inc. | All transactions secured by Square
      </p>
    </div>
  </div>
</footer>