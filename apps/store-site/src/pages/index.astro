---
import StoreLayout from '../layouts/StoreLayout.astro';
import '../styles/global.css';

interface WooProduct {
	id: number;
	name: string;
	short_description?: string;
	description?: string;
	categories?: WooCategory[];
	permalink: string;
	on_sale: boolean;
	prices: {
		price: string;
		currency_minor_unit: number;
		currency_prefix: string;
		currency_suffix: string;
	};
	images: Array<{ src: string; alt: string }>;
}

interface WooCategory {
	id: number;
	name: string;
	slug: string;
}

interface StoreProduct {
	id: number;
	name: string;
	description: string;
	categories: WooCategory[];
	price: string | null;
	priceAmount: number | null;
	image: { src: string; alt: string } | null;
	permalink: string;
	onSale: boolean;
}

function isRecord(value: unknown): value is Record<string, unknown> {
	return typeof value === 'object' && value !== null;
}

function isWooProduct(value: unknown): value is WooProduct {
	return (
		isRecord(value) &&
		typeof value.id === 'number' &&
		typeof value.name === 'string' &&
		typeof value.permalink === 'string' &&
		typeof value.on_sale === 'boolean' &&
		isRecord(value.prices) &&
		typeof value.prices.price === 'string' &&
		typeof value.prices.currency_minor_unit === 'number' &&
		typeof value.prices.currency_prefix === 'string' &&
		typeof value.prices.currency_suffix === 'string' &&
		Array.isArray(value.images) &&
		value.images.every(
			(image) =>
				isRecord(image) &&
				typeof image.src === 'string' &&
				typeof image.alt === 'string',
		) &&
		(value.short_description === undefined || typeof value.short_description === 'string') &&
		(value.description === undefined || typeof value.description === 'string') &&
		(value.categories === undefined ||
			(Array.isArray(value.categories) && value.categories.every(isWooCategory)))
	);
}

function isWooCategory(value: unknown): value is WooCategory {
	return (
		isRecord(value) &&
		typeof value.id === 'number' &&
		typeof value.name === 'string' &&
		typeof value.slug === 'string'
	);
}

function plainText(description: string | undefined): string {
	return (
		description
			?.replace(/<[^>]*>/g, ' ')
			.replace(/&#8217;|&#x2019;|&rsquo;/gi, '’')
			.replace(/\s+/g, ' ')
			.trim() ?? ''
	);
}

function formatPrice(product: WooProduct): string | null {
	const minorUnits = product.prices.currency_minor_unit;
	const amountInMinorUnits = Number(product.prices.price);

	if (!Number.isFinite(amountInMinorUnits) || product.prices.price === '') {
		return null;
	}

	const amount = new Intl.NumberFormat('en-US', {
		minimumFractionDigits: minorUnits,
		maximumFractionDigits: minorUnits,
	}).format(amountInMinorUnits / 10 ** minorUnits);

	return `${product.prices.currency_prefix}${amount}${product.prices.currency_suffix}`;
}

function getPriceAmount(product: WooProduct): number | null {
	const amountInMinorUnits = Number(product.prices.price);

	if (!Number.isFinite(amountInMinorUnits) || product.prices.price === '') {
		return null;
	}

	return amountInMinorUnits / 10 ** product.prices.currency_minor_unit;
}

const wordpressBaseUrl = (
	import.meta.env.PUBLIC_WORDPRESS_API_URL || 'http://host.docker.internal:8050'
).replace(/\/+$/, '');
const storeApiUrl = `${wordpressBaseUrl}/wp-json/wc/store/v1`;
const productsEndpoint = `${storeApiUrl}/products?per_page=100&orderby=popularity`;
const categoriesEndpoint = `${storeApiUrl}/products/categories?per_page=100&hide_empty=true`;

let products: StoreProduct[] = [];
let productsError: string | undefined;
let categories: WooCategory[] = [];
let categoriesError: string | undefined;

try {
	const response = await fetch(productsEndpoint);
	if (!response.ok) {
		throw new Error(`WooCommerce returned HTTP ${response.status}`);
	}

	const payload: unknown = await response.json();
	if (!Array.isArray(payload) || !payload.every(isWooProduct)) {
		throw new Error('WooCommerce returned an invalid product list');
	}

	products = payload.map((product) => ({
		id: product.id,
		name: product.name,
		categories: product.categories ?? [],
		description:
			plainText(product.short_description) ||
			plainText(product.description) ||
			'View this product for more details.',
		price: formatPrice(product),
		priceAmount: getPriceAmount(product),
		image: product.images[0]
			? {
					src: product.images[0].src,
					alt: product.images[0].alt || product.name,
				}
			: null,
		permalink: product.permalink,
		onSale: product.on_sale,
	}));
} catch (error) {
	console.error(`Failed to load WooCommerce products from ${productsEndpoint}:`, error);
	productsError = 'We could not load products right now. Please try again later.';
}

try {
	const response = await fetch(categoriesEndpoint);
	if (!response.ok) {
		throw new Error(`WooCommerce returned HTTP ${response.status}`);
	}

	const payload: unknown = await response.json();
	if (!Array.isArray(payload) || !payload.every(isWooCategory)) {
		throw new Error('WooCommerce returned an invalid product category list');
	}

	categories = payload;
} catch (error) {
	console.error(`Failed to load WooCommerce categories from ${categoriesEndpoint}:`, error);
	categoriesError = 'Product categories could not be loaded. Showing all products.';
}
---

<StoreLayout title="Store">
