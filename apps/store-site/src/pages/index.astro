			<p class="sr-only" data-sort-status aria-live="polite"></p>
		</section>

		<section id="impact" class="bg-surface-container-low py-20">
			<div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-8 text-center md:grid-cols-3">
				<div class="space-y-4">
					<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-sm">
						<span class="material-symbols-outlined text-3xl text-brand-blue" aria-hidden="true">volunteer_activism</span>
					</div>
					<h3 class="text-xl font-bold text-on-surface">Community Funded</h3>
					<p class="text-brand-text">100% of proceeds fund local empowerment and vocational training programs.</p>
				</div>
				<div class="space-y-4">
					<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-sm">
						<span class="material-symbols-outlined text-3xl text-brand-blue" aria-hidden="true">local_shipping</span>
					</div>
					<h3 class="text-xl font-bold text-on-surface">Reliable Delivery</h3>
					<p class="text-brand-text">Fast, tracked shipping on every order to ensure your gear arrives safely.</p>
				</div>
