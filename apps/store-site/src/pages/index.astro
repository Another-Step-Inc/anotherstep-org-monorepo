		</button>
		<button
			type="button"
			class="flex flex-col items-center justify-center px-4 py-2 text-slate-500 transition-transform duration-200 hover:scale-105 active:scale-90"
		>
			<span class="material-symbols-outlined" aria-hidden="true">person</span>
			<span class="mt-1 text-[10px] font-semibold uppercase tracking-wider">Profile</span>
		</button>
