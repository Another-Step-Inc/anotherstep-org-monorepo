							<div class="mt-auto flex items-center justify-between gap-3">
								<span class="text-2xl font-black text-brand-blue">
									{product.price ?? 'See product'}
								</span>
								<a
									href={product.permalink}
									class="flex items-center gap-2 rounded-full bg-brand-blue px-6 py-3 font-bold text-on-brand-blue transition-all hover:bg-brand-blue-container active:scale-95"
