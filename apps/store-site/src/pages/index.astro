---
import StoreLayout from '../layouts/StoreLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from 'src/components/Footer.astro';
import '../styles/global.css'

const products = {

}
---
<StoreLayout title='Store'>
	<section class="max-w-7xl mx-auto px-4 py-8">
		<div class="bg-[#0E75BC] rounded-[2.5rem] p-12 text-white relative overflow-hidden flex flex-col md:flex-row items-center gap-8">
		<div class="md:w-1/2 z-10">
			<h1 class="text-4xl md:text-6xl font-black mb-6 leading-tight">
			Shop with <span class="text-[#F9EF21]">Purpose</span>
			</h1>
			<p class="text-lg text-blue-50 mb-8 max-w-lg">
			Every item in our store is designed to support the "Without Walls" model, providing community-based independence for the people we serve.
			</p>
			<a href="/products" class="inline-block bg-[#EC1F28] text-white px-10 py-4 rounded-2xl font-black text-xl hover:scale-105 transition-transform shadow-lg">
			Browse the Collection
			</a>
		</div>
		<div class="md:w-1/2 relative z-10">
			<img src="/store-hero-image.jpg" class="rounded-[2rem] shadow-2xl border-4 border-white/10" alt="Another Step Merchandise" />
		</div>
		<div class="absolute -bottom-20 -right-20 w-80 h-80 bg-[#F9EF21] rounded-full opacity-20 blur-3xl"></div>
		</div>
	</section>

	<section class="max-w-7xl mx-auto px-4 py-12">
		<div class="flex items-center justify-between mb-8 border-b-2 border-[#EEEEEE] pb-4">
			<h2 class="text-3xl font-black text-[#232020] uppercase tracking-tighter">Custom Apparel</h2>
			<a href="/products" class="text-[#0E75BC] font-bold hover:underline">View All Collection →</a>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
			<div class="bg-white rounded-[2rem] border border-[#EEEEEE] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-shadow">
			<div class="p-8 bg-[#F9F9F9] flex justify-center items-center aspect-square">
				<img src="/tshirt-mockup.png" class="w-full h-auto object-contain" />
			</div>
			<div class="p-6 text-center flex-grow">
				<h3 class="font-bold text-[#232020] text-lg">T-Shirts Apparel</h3>
				<p class="text-[#808080] text-sm mt-1">As low as <span class="text-[#EC1F28] font-black">$15.99</span> ea.</p>
			</div>
			<a href="/product/tshirt" class="bg-[#0E75BC] text-white py-4 font-black uppercase tracking-widest text-sm hover:bg-[#232020] transition-colors text-center">
				Buy Now
			</a>
		</div>

		</div>
	</section>
</StoreLayout>