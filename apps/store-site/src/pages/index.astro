</StoreLayout>

<script>
	const filterToggle = document.querySelector<HTMLButtonElement>('[data-filter-toggle]');
	const filterMenu = document.querySelector<HTMLElement>('[data-filter-menu]');
	const filterDropdown = filterToggle?.parentElement;
	const sortToggle = document.querySelector<HTMLButtonElement>('[data-sort-toggle]');
	const sortMenu = document.querySelector<HTMLElement>('[data-sort-menu]');
	const sortDropdown = sortToggle?.parentElement;
	const productGrid = document.querySelector<HTMLElement>('[data-product-grid]');
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
	const saleFilter = document.querySelector<HTMLInputElement>('[data-sale-filter]');
	const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-clear-filters]');
	const sortOptions = document.querySelectorAll<HTMLButtonElement>('[data-sort-option]');
	const productCards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-id]'));
	const noResultsMessage = document.querySelector<HTMLElement>('[data-no-category-results]');
	const sortStatus = document.querySelector<HTMLElement>('[data-sort-status]');

	let activeCategory = '*';
	let saleOnly = false;
	let activeSort = 'featured';

	function setMenuVisibility(
		menu: HTMLElement | null,
		toggle: HTMLButtonElement | null,
		isOpen: boolean,
	): void {
		if (!menu || !toggle) return;
		menu.hidden = !isOpen;
		menu.classList.toggle('hidden', !isOpen);
		toggle.setAttribute('aria-expanded', String(isOpen));
	}

	function closeMenus(): void {
		setMenuVisibility(filterMenu, filterToggle, false);
		setMenuVisibility(sortMenu, sortToggle, false);
	}

	filterToggle?.addEventListener('click', () => {
		const isOpen = filterToggle.getAttribute('aria-expanded') !== 'true';
		setMenuVisibility(sortMenu, sortToggle, false);
		setMenuVisibility(filterMenu, filterToggle, isOpen);
	});

	sortToggle?.addEventListener('click', () => {
		const isOpen = sortToggle.getAttribute('aria-expanded') !== 'true';
		setMenuVisibility(filterMenu, filterToggle, false);
		setMenuVisibility(sortMenu, sortToggle, isOpen);
	});

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Node)) return;
		if (!filterDropdown?.contains(event.target)) setMenuVisibility(filterMenu, filterToggle, false);
		if (!sortDropdown?.contains(event.target)) setMenuVisibility(sortMenu, sortToggle, false);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		closeMenus();
	});

	function updateProductVisibility(): void {
		let visibleProducts = 0;
		productCards.forEach((card) => {
			const productCategories = card.dataset.categorySlugs?.split(' ') ?? [];
			const matchesCategory =
				activeCategory === '*' || productCategories.includes(activeCategory);
			const matchesSaleFilter = !saleOnly || card.dataset.onSale === 'true';
			const isVisible = matchesCategory && matchesSaleFilter;
			card.hidden = !isVisible;
			card.classList.toggle('hidden', !isVisible);
			if (isVisible) visibleProducts += 1;
		});

		if (noResultsMessage) {
			noResultsMessage.hidden = visibleProducts > 0;
			noResultsMessage.classList.toggle('hidden', visibleProducts > 0);
		}
	}

	filterButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const selectedCategory = button.dataset.categoryFilter;
			if (selectedCategory === undefined) return;

			activeCategory = selectedCategory;
			filterButtons.forEach((filterButton) => {
				const isSelected = filterButton.dataset.categoryFilter === activeCategory;
				filterButton.setAttribute('aria-pressed', String(isSelected));
				filterButton.classList.toggle('bg-brand-blue', isSelected);
				filterButton.classList.toggle('text-white', isSelected);
				filterButton.classList.toggle('border', !isSelected);
				filterButton.classList.toggle('border-brand-blue', !isSelected);
				filterButton.classList.toggle('text-brand-blue', !isSelected);
			});

			updateProductVisibility();
		});
	});

	saleFilter?.addEventListener('change', () => {
		saleOnly = saleFilter.checked;
		updateProductVisibility();
	});

	clearFiltersButton?.addEventListener('click', () => {
		activeCategory = '*';
		saleOnly = false;
		if (saleFilter) saleFilter.checked = false;

		filterButtons.forEach((button) => {
			const isSelected = button.dataset.categoryFilter === activeCategory;
			button.setAttribute('aria-pressed', String(isSelected));
			button.classList.toggle('bg-brand-blue', isSelected);
			button.classList.toggle('text-white', isSelected);
			button.classList.toggle('border', !isSelected);
			button.classList.toggle('border-brand-blue', !isSelected);
			button.classList.toggle('text-brand-blue', !isSelected);
		});

		updateProductVisibility();
	});

	function sortProducts(sortBy: string): void {
		if (!productGrid) return;

		const compareFeatured = (first: HTMLElement, second: HTMLElement) =>
			Number(first.dataset.featuredOrder) - Number(second.dataset.featuredOrder);
		const sortedCards = [...productCards].sort((first, second) => {
			if (sortBy === 'featured') return compareFeatured(first, second);

			if (sortBy === 'price-ascending' || sortBy === 'price-descending') {
				const firstPriceValue = first.dataset.sortPrice ?? '';
				const secondPriceValue = second.dataset.sortPrice ?? '';
				const firstPrice = Number(firstPriceValue);
				const secondPrice = Number(secondPriceValue);
				const firstHasPrice = firstPriceValue !== '' && Number.isFinite(firstPrice);
				const secondHasPrice = secondPriceValue !== '' && Number.isFinite(secondPrice);

				if (firstHasPrice !== secondHasPrice) return firstHasPrice ? -1 : 1;
				if (!firstHasPrice) return compareFeatured(first, second);

				const direction = sortBy === 'price-ascending' ? 1 : -1;
				return direction * (firstPrice - secondPrice) || compareFeatured(first, second);
			}

			const nameComparison = (first.dataset.sortName ?? '').localeCompare(
				second.dataset.sortName ?? '',
				undefined,
				{ numeric: true, sensitivity: 'base' },
			);
			return nameComparison || compareFeatured(first, second);
		});

		sortedCards.forEach((card) => {
			if (noResultsMessage) {
				productGrid.insertBefore(card, noResultsMessage);
			} else {
				productGrid.append(card);
			}
		});

		const selectedSort = Array.from(sortOptions).find(
			(option) => option.dataset.sortOption === sortBy,
		)?.textContent?.trim();
		if (sortStatus && selectedSort) sortStatus.textContent = `Products sorted by ${selectedSort}.`;
	}

	sortOptions.forEach((option) => {
		option.addEventListener('click', () => {
			const sortBy = option.dataset.sortOption;
			if (!sortBy) return;

			activeSort = sortBy;
			sortOptions.forEach((sortOption) => {
				const isSelected = sortOption.dataset.sortOption === activeSort;
				sortOption.setAttribute('aria-pressed', String(isSelected));
				sortOption.classList.toggle('bg-brand-blue', isSelected);
				sortOption.classList.toggle('text-white', isSelected);
				sortOption.classList.toggle('text-on-surface', !isSelected);
			});

			sortProducts(activeSort);
			setMenuVisibility(sortMenu, sortToggle, false);
		});
	});
</script>
