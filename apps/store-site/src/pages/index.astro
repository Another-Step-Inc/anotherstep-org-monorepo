	<nav
		aria-label="Mobile store navigation"
		class="fixed bottom-0 left-0 z-50 flex w-full justify-around rounded-t-[2rem] border-t border-slate-100 bg-white/90 px-4 pb-6 pt-3 shadow-[0_-8px_24px_rgba(0,0,0,0.05)] backdrop-blur-xl md:hidden"
	>
