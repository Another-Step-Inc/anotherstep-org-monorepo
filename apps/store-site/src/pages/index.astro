							)}
							{product.onSale && (
								<span class="absolute left-4 top-4 rounded-full bg-brand-red px-4 py-1 text-xs font-bold uppercase text-white">
									On Sale
								</span>
							)}
						</div>
						<div class="flex flex-grow flex-col p-8">
							{product.categories.length > 0 && (
								<div class="mb-3 flex flex-wrap gap-2" aria-label="Product categories">
									{product.categories.map((category) => (
										<span class="rounded-full bg-surface-container px-3 py-1 text-xs font-semibold text-brand-blue">
