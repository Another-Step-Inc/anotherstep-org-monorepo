# Local PostgreSQL connection for pnpm db:migrate and pnpm db:seed from the host.
DATABASE_URL=postgres://adminportal:adminportal-local-password@localhost:5432/adminportal

# Docker Compose overrides DATABASE_URL inside the dev container with this service URL.
ADMIN_PORTAL_DATABASE_URL=postgres://adminportal:adminportal-local-password@postgres:5432/adminportal
POSTGRES_DB=adminportal
POSTGRES_USER=adminportal
POSTGRES_PASSWORD=adminportal-local-password
POSTGRES_PORT=5432

# Local-only seed accounts. Change every password outside local development.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=AdminPortal-Local-Only-123!
ADMIN_NAME=Portal Admin
SEED_LEAD_EMAIL=lead@localhost
SEED_LEAD_PASSWORD=Lead-Local-Only-123!
SEED_LEAD_NAME=Lead Reviewer
SEED_DEVELOPER_EMAIL=developer@localhost
SEED_DEVELOPER_PASSWORD=Developer-Local-Only-123!
SEED_DEVELOPER_NAME=Developer User
ADMIN_PORTAL_HOST=localhost

# WordPress staging API. Use host.docker.internal instead of localhost in Docker Compose.
WORDPRESS_API_URL=http://localhost:8050
WORDPRESS_API_URL_DOCKER=http://host.docker.internal:8050
WORDPRESS_API_USERNAME=
WORDPRESS_API_APPLICATION_PASSWORD=
