{
    "name": "@anothersteporg/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./lib/*": "./src/lib/*.js",
        "./layouts/*": "./src/layouts/*.astro",
        "./components/*": "./src/components/*.astro",
        "./components/admin/*.astro": "./src/components/admin/*.astro",
        "./styles/global.css": {
            "style": "./src/styles/global.css",
            "default": "./src/styles/global.css"
        },
        "./styles/admin-portal.css": {
            "style": "./src/styles/admin-portal.css",
            "default": "./src/styles/admin-portal.css"
        }
    },
    "peerDependencies": {
        "astro": "^4.0.0 || ^5.0.0"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@heroicons/react": "^2.2.0",
        "astro-heroicons": "2.1.5-1"
    },
    "devDependencies": {
        "tailwindcss": "^4.2.4"
    }
}