---
// src/components/BlockResolver.astro
import Hero from './blocks/Hero.astro';
import TextBlock from './blocks/TextBlock.astro';
import ImageGallery from './blocks/ImageGallery.astro';
import TwoColumns from './blocks/TwoColumns.astro';
import TwoColumnsBorderTop from './blocks/TwoColumnsBorderTop.astro';
import ThreeColumns from './blocks/ThreeColumns.astro';
import OneColumnCard from './blocks/OneColumnCard.astro';
import SplitFeature from './blocks/SplitFeature.astro';
import CustomGridSection from './blocks/CustomGridSection.astro';

import { wpFetch, EDITOR_BLOCKS_FRAGMENT } from '../lib/wp.js';
import { VALUES_ARCHIVE_QUERY } from "../lib/queries";

const { blocks = [] } = Astro.props
// 1. Get a combined string of all "Container" block outputs
const parentOutputs = blocks
    .filter((b: any) => b.name.includes('anotherstep/'))
    .map((b: any) => b.renderedHtml)
    .join('');

// 2. Filter the blocks
const uniqueBlocks = blocks.filter((block: any) => {
    // If it's a core paragraph/heading, check if it's already inside a parent's HTML
    if (block.name === 'core/paragraph' || block.name === 'core/heading') {
        // If the paragraph's HTML exists inside the combined parent HTML, skip it
        if (parentOutputs.includes(block.renderedHtml)) {
            return false;
        }
    }
    return true;
});

const valuesResponse = await wpFetch(VALUES_ARCHIVE_QUERY);

const dynamicCardsData = (valuesResponse && 'values' in valuesResponse)
  ? valuesResponse.values?.nodes?.map((node: any) => ({
      title: node.title || '',
      content: node.content || node.excerpt || '',
      icon: node.cardIcon || '',  // Matches the field registered to the Value type
      theme: node.cardTheme || '' // Matches the field registered to the Value type
    })) || []
  : [];
---

{uniqueBlocks.map((block: any) => {
    if (!block) return null;
    if (block.name === 'anotherstep/custom-grid-card') return false;

    let attrs;
    switch (block.name) {
        case 'core/paragraph':
        case 'core/heading':
            return <TextBlock content={block.renderedHtml} />

        case 'core/image':
        case 'core/gallery':
            // The attributesJson contains the URL and alt text from WP
            const imageAttrs = block.attributesJSON ? JSON.parse(block.attributesJSON) : {};
            return <ImageGallery url={block.attributes?.url} alt={block.attributes?.alt} />;
        
        case 'anotherstep/page-hero-section': {
            // Parse block attributes out of JSON string
            attrs = block.attributes || {};
            return (
                <Hero 
                    content={block.renderedHtml}
                    layoutType={attrs.layoutType}
                    imageDecoration={attrs.imageDecoration}
                    hasBadge={attrs.hasBadge}
                    badgeText={attrs.badgeText}
                    badgeStyle={attrs.badgeStyle}
                    quoteText={attrs.quoteText}
                    statsNumber={attrs.statsNumber}
                    statsText={attrs.statsText}
                    statsBgColor={attrs.statsBgColor}
                    statsTextColor={attrs.statsTextColor}
                    isImageLarge={attrs.isImageLarge}
                    isStatsRotated={attrs.isStatsRotated}
                    hasExtraTextDiv={attrs.hasExtraTextDiv}
                    extraDivText={attrs.extraDivText}
                    extraDivIcon={attrs.extraDivIcon}
                    extraDivIconColor={attrs.extraDivIconColor}
                    extraDivBgColor={attrs.extraDivBgColor}
                    title={attrs.heroTitle}
                    paragraph={attrs.heroDescription}
                    imageSrc={attrs.heroImageUrl}
                    btn1Text={attrs.btn1Text}
                    btn1Url={attrs.btn1Url}
                    btn2Text={attrs.btn2Text}
                    btn2Url={attrs.btn2Url}
                />
            );
        }
        case 'anotherstep/homepage-about-section':
            return <TwoColumns content={block.renderedHtml} />

        case 'anotherstep/custom-grid-section':
            attrs = block.attributes || {};

            const resolvedInnerBlocks = (block.innerBlocks || []).map((child: any) => {
                if (child.attributesJSON) {
                    try {
                        return { attributes: JSON.parse(child.attributesJSON) };
                    } catch (e) {
                        console.error("Failed to parse inner block JSON", e);
                    }
                }
                return child; // Fallback to raw attributes if already an object
            });

            return <CustomGridSection 
                headline={attrs.headline}
                description={attrs.description}
                bgStyle={attrs.bgStyle}
                textAlignment={attrs.textAlignment}
                styleVariant={attrs.styleVariant}
                useQuery={attrs.useQuery}
                postType={attrs.postType}
                postsPerPage={attrs.postsPerPage}
                renderedHtml={block.renderedHtml}
                innerBlocks={resolvedInnerBlocks} 
                dynamicCards={dynamicCardsData}
            />
        
        case 'anotherstep/homepage-ethics-section':
            return <OneColumnCard content={block.renderedHtml} />
        
        case 'anotherstep/homepage-legal-section':
            return <TwoColumnsBorderTop content={block.renderedHtml} />

        case 'anotherstep/split-feature-section':
            // Parse block attributes out of JSON string
            attrs = block.attributes || {};
            return (
                <SplitFeature 
                    imageAlignment={attrs.imageAlignment}
                    backgroundColor={attrs.backgroundColor}
                    eyebrowText={attrs.eyebrowText}
                    underlineAccent={attrs.underlineAccent}
                    mediaUrl={attrs.mediaUrl}
                    mediaAlt={attrs.mediaAlt}
                    secondaryMediaUrl={attrs.secondaryMediaUrl}
                    metricNumber={attrs.metricNumber}
                    metricLabel={attrs.metricLabel}
                    iconName={attrs.iconName}
                    iconTitle={attrs.iconTitle}
                    splitTitle={attrs.splitTitle}
                    splitDescription={attrs.splitDescription}
                />
            );
        default:
            // Fallback for blocks there are no components built yet
            return <div class="wp-block-fallback"set:html={block.renderedHtml} />;
    }
})}