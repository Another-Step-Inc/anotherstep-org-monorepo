---
interface Props {
  title?: string;
  description?: string;
  showModeToggle?: boolean;
  generalFormUrl?: string;
  tributeFormUrl?: string;
  taxDisclosure?: string;
  showSecurityBadge?: boolean;
}

const {
  title = 'Secure Donation Form',
  description = '',
  showModeToggle = true,
  generalFormUrl = '',
  tributeFormUrl = '',
  taxDisclosure = '',
  showSecurityBadge = true,
} = Astro.props;
---

<div class="bg-surface-container-lowest p-8 md:p-12 rounded-[2rem] shadow-sm relative overflow-hidden border border-outline-variant/20 h-full">
  <div class="absolute top-0 right-0 w-64 h-64 bg-brand-blue/5 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"></div>
  
  <div class="relative z-10 space-y-10" data-donor-form>
    <div class="text-center py-6 space-y-6">
      {title && <h2 class="text-headline-lg font-bold text-on-surface">{title}</h2>}
      {description && <p class="text-on-surface-variant">{description}</p>}

      {
        showModeToggle && (
          <div class="flex justify-center mb-8">
            <div class="inline-flex p-1 bg-surface-container-high rounded-full">
              <button
                type="button"
                class="px-8 py-2 rounded-full font-bold transition-all bg-surface-container-lowest text-brand-blue shadow-sm"
                data-toggle-btn
                data-url={generalFormUrl}
              >
                General Donation
              </button>
              <button
                type="button"
                class="px-8 py-2 rounded-full font-bold transition-all text-on-surface-variant"
                data-toggle-btn
                data-url={tributeFormUrl}
              >
                Tribute Donation
              </button>
            </div>
          </div>
        )
      }

      <div class="w-full min-h-[600px] bg-surface-container-low rounded-2xl border-2 border-dashed border-outline-variant/30 flex items-center justify-center">
        <iframe
          data-iframe
          src={generalFormUrl}
          class="w-full h-full min-h-[600px] border-0"
        ></iframe>
      </div>

      {
        taxDisclosure && (
          <div class="mt-6 px-4">
            <p class="text-sm text-on-surface-variant/80 leading-relaxed text-center italic">
              <span class="font-bold">TAX DISCLOSURE:</span> {taxDisclosure}
            </p>
          </div>
        )
      }

      {
        showSecurityBadge && (
          <div class="flex items-center justify-center gap-4 pt-6 border-t border-outline-variant/30">
            <span class="material-symbols-outlined text-brand-blue">lock</span>
            <span class="text-label-md font-bold text-on-surface-variant uppercase tracking-wider">
              Secure 256-bit SSL Encryption
            </span>
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-donor-form]').forEach((container) => {
    const buttons = container.querySelectorAll('[data-toggle-btn]');
    const iframe = container.querySelector('[data-iframe]') as HTMLIFrameElement;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        if (url && iframe) {
          iframe.src = url;
        }

        buttons.forEach((b) => {
          b.classList.remove('bg-surface-container-lowest', 'text-brand-blue', 'shadow-sm');
          b.classList.add('text-on-surface-variant');
        });

        btn.classList.add('bg-surface-container-lowest', 'text-brand-blue', 'shadow-sm');
        btn.classList.remove('text-on-surface-variant');
      });
    });
  });
</script>