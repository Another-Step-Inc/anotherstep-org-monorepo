---
interface Props {
    sectionTitle?: string;
    sideTitle?: string;
    sideDescription?: string;
    saveTheDateText?: string;
    meetingTitle?: string;
    meetingDescription?: string;
    inPersonTitle?: string;
    inPersonDetails?: string;
    digitalTitle?: string;
    zoomUrl?: string;
    zoomButtonText?: string;
    phoneText?: string;
    phoneDetails?: string;
    meetingId?: string;
}

const {
    sectionTitle,
    sideTitle,
    sideDescription,
    saveTheDateText,
    meetingTitle,
    meetingDescription,
    inPersonTitle,
    inPersonDetails,
    digitalTitle,
    zoomUrl,
    zoomButtonText,
    phoneText,
    phoneDetails,
    meetingId,
} = Astro.props;
---

<section id="self-advocacy" class="py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="flex flex-col lg:flex-row gap-12 items-start">
            <!-- Sidebar Column -->
            <div class="lg:w-1/3">
                <div class="flex items-center gap-3 mb-6">
                    <span class="material-symbols-outlined text-brand-blue text-3xl">calendar_month</span>
                    <h2 class="text-[2.5rem] font-display font-black text-on-surface tracking-tight" set:html={sectionTitle} />
                </div>
                <div class="bg-brand-blue-container/5 p-8 rounded-xl border border-brand-blue/10">
                    <h3 class="text-xl font-bold text-brand-blue mb-4" set:html={sideTitle} />
                    <p class="text-on-surface-variant mb-6 leading-relaxed" set:html={sideDescription} />
                    <div class="flex items-center gap-2 text-brand-red font-bold">
                        <span class="material-symbols-outlined">notification_important</span>
                        <span set:html={saveTheDateText} />
                    </div>
                </div>
            </div>

            <!-- Content Grid Column -->
            <div class="lg:w-2/3 grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Banner Card -->
                <div class="bg-surface-container-low p-8 rounded-xl organic-shadow md:col-span-2">
                    <h3 class="text-xl font-bold text-on-surface mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-brand-blue">event_repeat</span>
                        <span set:html={meetingTitle} />
                    </h3>
                    <p class="text-body-lg text-on-surface-variant mb-4" set:html={meetingDescription} />
                </div>

                <!-- In Person Card -->
                <div class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/20">
                    <h4 class="font-bold text-brand-blue mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined">location_on</span>
                        <span set:html={inPersonTitle} />
                    </h4>
                    <p class="text-sm text-on-surface-variant leading-relaxed" set:html={inPersonDetails} />
                </div>

                <!-- Digital Card -->
                <div class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/20 flex flex-col">
                    <h4 class="font-bold text-brand-blue mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined">videocam</span>
                        <span set:html={digitalTitle} />
                    </h4>
                    <div class="space-y-4">
                        <a 
                            class="bg-brand-blue text-on-brand-blue rounded-full px-6 py-3 font-bold text-center block hover:bg-brand-blue-container transition-colors" 
                            href={zoomUrl} 
                            target="_blank"
                            rel="noopener noreferrer"
                            set:html={zoomButtonText}
                        />
                        <div class="text-xs text-on-surface-variant">
                            <p class="font-bold mb-1" set:html={phoneText} />
                            <p set:html={phoneDetails} />
                            <p set:html={meetingId} />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>