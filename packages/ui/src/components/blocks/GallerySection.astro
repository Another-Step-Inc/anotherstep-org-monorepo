---
export const GallerySectionFragment = `
    ... on AnotherstepGalleryPlaceholder {
        attributes {
          layoutType
          showFilterBar
          itemsPerPage
          galleryTitle
          galleryDescription
          categorySlug
          tagFilter
          maxItems
        }
    }
`;

import { getVariantClass, resolveImageUrl } from '../../lib/utils.ts';
const { data } = Astro.props;
---

  <section class="max-w-[1440px] mx-auto px-12 pb-24">
    <h3 class="text-2xl font-bold text-brand-blue mb-8 flex items-center gap-3">
      <span class="material-symbols-outlined">auto_awesome_motion</span>
      Stories of Independence
    </h3>
    <div class="masonry-grid">
      {data?.galleryItems?.map((item: any) => {
        const variantClass = getVariantClass(item.sizeVariant);

        const imageUrl = resolveImageUrl(item.image);
        const altText = item.image?.node?.altText || item.title || "Gallery image";

        return (
          <div class={`group relative overflow-hidden rounded-2xl bg-surface-container-low transition-all duration-500 hover:shadow-xl ${variantClass}`}>
            <img
              src={imageUrl}
              alt={altText}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-blue/90 via-brand-blue/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
              <div>
                {item.categoryTag && (
                  <span class="text-label-md uppercase tracking-wider font-bold mb-1 block opacity-80 text-white">
                    {item.categoryTag}
                  </span>
                )}
                <span class="text-white font-bold text-lg">{item.title}</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>
  <style>
    .masonry-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        grid-auto-rows: 250px;
        gap: 1.5rem;
    }
    .masonry-item-tall { grid-row: span 2; }
    .masonry-item-wide { grid-column: span 2; }
    @media (max-width: 768px) {
        .masonry-item-wide { grid-column: span 1; }
    }
    .glass-nav {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
    }
</style>