---
interface Props {
  headline?: string;
  description?: string;
  btn1Text?: string;
  btn1Url?: string;
  btn2Text?: string;
  btn2Url?: string;
  directorName?: string;
  directorTitle?: string;
  directorRegions?: string;
  directorPhone?: string;
  directorImageUrl?: string;
  directorImageId?: string;
}

const {
  headline,
  description,
  btn1Text,
  btn1Url,
  btn2Text,
  btn2Url,
  directorName,
  directorTitle,
  directorRegions,
  directorPhone,
  directorImageUrl,
  directorImageId
} = Astro.props;
---
<section class="py-24 bg-surface">
  <div class="max-w-screen-2xl mx-auto px-8">
    <div class="bg-surface-container p-12 md:p-20 rounded-xl relative overflow-hidden">
      
      <!-- Background SVG Accent -->
      <div class="absolute top-0 right-0 w-1/3 h-full opacity-10 pointer-events-none">
        <svg class="h-full w-full" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <path d="M44.7,-76.4C58.1,-69.2,69.2,-58.1,76.4,-44.7C83.7,-31.3,87.1,-15.7,87.1,0C87.1,15.7,83.7,31.3,76.4,44.7C69.2,58.1,58.1,69.2,44.7,76.4C31.3,83.7,15.7,87.1,0,87.1C-15.7,87.1,-31.3,83.7,-44.7,76.4C-58.1,69.2,-69.2,58.1,-76.4,44.7C-83.7,31.3,-87.1,15.7,-87.1,0C-87.1,-15.7,-83.7,-31.3,-76.4,-44.7C-69.2,-58.1,-58.1,-69.2,-44.7,-76.4C-31.3,-83.7,-15.7,-87.1,0,-87.1C15.7,-87.1,31.3,-83.7,44.7,-76.4Z" fill="#004E8B" transform="translate(100 100)"></path>
        </svg>
      </div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Call to Action Text Area -->
        <div>
          {headline && (
            <h2 class="text-[3rem] font-extrabold text-brand-blue leading-tight mb-6" set:html={headline} />
          )}
          {description && (
            <p class="text-xl text-on-surface-variant mb-12" set:html={description} />
          )}
          <div class="mt-12 flex flex-wrap gap-4">
            {btn1Text && (
              <a 
                href={btn1Url || '#'} 
                class="bg-brand-blue text-on-brand-blue px-10 py-4 rounded-full font-bold text-body-lg shadow-lg hover:bg-brand-blue-container transition-all text-center inline-block"
              >
                {btn1Text}
              </a>
            )}
            {btn2Text && (
              <a 
                href={btn2Url || '#'} 
                class="border-2 border-outline-variant px-10 py-4 rounded-full font-bold text-body-lg hover:bg-surface-container-low transition-all text-center inline-block"
              >
                {btn2Text}
              </a>
            )}
          </div>
        </div>

        <!-- Director Information Sidebar Display -->
        <div class="bg-surface-container-lowest p-10 rounded-xl shadow-xl border-l-8 border-brand-red">
          <div class="flex flex-col sm:flex-row items-start gap-6">
            {directorImageUrl && (
              <div class="w-24 h-24 rounded-full bg-surface-container-high flex-shrink-0 overflow-hidden">
                <img class="w-full h-full object-cover" alt={directorName} src={directorImageUrl} />
              </div>
            )}
            <div>
              <h4 class="text-2xl font-bold text-on-surface" set:html={directorName} />
              {directorTitle && (
                <p class="text-brand-red font-medium uppercase tracking-wider text-sm mb-4" set:html={directorTitle} />
              )}
              <div class="space-y-3">
                {directorRegions && (
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue">location_on</span>
                    <span>{directorRegions}</span>
                  </div>
                )}
                {directorPhone && (
                  <div class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-brand-blue">call</span>
                    <span class="font-bold text-on-surface" set:html={directorPhone} />
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>