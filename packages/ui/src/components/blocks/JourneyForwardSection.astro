---
interface Props {
  sectionTitle?: string;
  step1Number?: string;
  step1Label?: string;
  step2Number?: string;
  step2Label?: string;
  step3Number?: string;
  step3Label?: string;
}

const {
  sectionTitle,
  step1Number,
  step1Label,
  step2Number,
  step2Label,
  step3Number,
  step3Label,
} = Astro.props;
---

<section class="max-w-7xl mx-auto px-8 py-24 border-t-0 text-center">
  <h2 class="text-4xl md:text-5xl font-black text-brand-blue mb-12">
    {sectionTitle}
  </h2>
  <div class="flex flex-col md:flex-row items-center justify-center gap-4">
    <!-- Step 01 -->
    <div class="w-full md:w-64 h-32 bg-brand-blue rounded-2xl flex flex-col items-center justify-center text-on-primary p-4 shadow-lg">
      <span class="text-4xl font-black mb-1">{step1Number}</span>
      <span class="text-sm font-bold uppercase tracking-widest">{step1Label}</span>
    </div>

    <div class="hidden md:block w-12 h-2 bg-surface-container-highest rounded-full"></div>

    <!-- Step 02 -->
    <div class="w-full md:w-64 h-32 bg-brand-red rounded-2xl flex flex-col items-center justify-center text-on-secondary p-4 shadow-lg">
      <span class="text-4xl font-black mb-1">{step2Number}</span>
      <span class="text-sm font-bold uppercase tracking-widest">{step2Label}</span>
    </div>

    <div class="hidden md:block w-12 h-2 bg-surface-container-highest rounded-full"></div>

    <!-- Step 03 -->
    <div class="w-full md:w-64 h-32 bg-brand-yellow text-on-tertiary-fixed rounded-2xl flex flex-col items-center justify-center p-4 shadow-lg">
      <span class="text-4xl font-black mb-1">{step3Number}</span>
      <span class="text-sm font-bold uppercase tracking-widest">{step3Label}</span>
    </div>
  </div>
</section>