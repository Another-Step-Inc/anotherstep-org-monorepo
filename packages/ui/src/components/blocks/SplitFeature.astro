---
export const SplitFeatureFragment = `
  ... on AnotherstepSplitFeatureSection {
    attributes {
      splitTitle
      splitDescription
      imageAlignment
      backgroundColor
      eyebrowText
      underlineAccent
      mediaId
      mediaUrl
      mediaAlt
      secondaryMediaUrl
      metricNumber
      metricLabel
      iconName
      iconTitle
    }
  }
`;

interface Props {
    splitTitle: string;
    splitDescription: string;
    imageAlignment?: string;
    backgroundColor?: string;
    eyebrowText?: string;
    underlineAccent?: boolean;
    mediaUrl?: string;
    mediaAlt?: string;
    secondaryMediaUrl?: string;
    metricNumber?: string;
    metricLabel?: string;
    iconName?: string;
    iconTitle?: string;
}

const { splitTitle, splitDescription, imageAlignment, backgroundColor, eyebrowText, underlineAccent, mediaUrl, mediaAlt, secondaryMediaUrl, metricNumber, metricLabel, iconName, iconTitle } = Astro.props;

const alignment = imageAlignment || undefined;
const bgClass = `bg-${backgroundColor}` || undefined;
const isLeft = alignment === 'left';

console.log("--- WORKING BLOCK PAYLOAD ---") ;
console.log(JSON.stringify(splitDescription, null, 2));
---
<section class={`py-24 ${bgClass} project-split-feature`}>
  <div class="max-w-7xl mx-auto px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      {/* Content Column Layout Routing Segment */}
      <div class={`lg:col-span-7 ${isLeft ? 'lg:order-2' : ''}`}>
        {eyebrowText && (
          <span class="inline-block px-4 py-1 rounded-full bg-brand-blue-fixed text-on-brand-blue-fixed text-label-md font-bold mb-6">
            {eyebrowText}
          </span>
        )}  
        {splitTitle && (
            <h2 class="text-headline-lg font-bold text-on-surface mb-12 relative">
              {splitTitle}
              {underlineAccent && (
                <div class="absolute -bottom-4 left-0 w-24 h-2 bg-brand-red rounded-full"></div>
              )}
            </h2>
        )}
        {splitDescription && (
            <div class="text-lg text-on-surface-variant leading-relaxed [&>p]:mb-6 [&>blockquote]:border-l-4 [&>blockquote]:border-brand-blue [&>blockquote]:pl-4 [&>blockquote]:italic [&>blockquote]:my-6">
              <Fragment set:html={splitDescription} />
            </div>
        )}
      </div>

      {/* Asymmetric Graphical Display Grid Segment */}
      <div class={`lg:col-span-5 relative ${isLeft ? 'lg:order-1' : ''}`}>
        <div class="grid grid-cols-2 gap-4 pt-12">
          
          <div class="space-y-4">
            {mediaUrl && (
              <div class="aspect-square rounded-xl overflow-hidden shadow-lg">
                <img alt={mediaAlt || ''} class="w-full h-full object-cover" src={mediaUrl} />
              </div>
            )}
            
            {(metricNumber || metricLabel) && (
              <div class="bg-brand-red p-8 rounded-xl text-on-brand-red">
                <div class="text-4xl font-extrabold mb-2">{metricNumber}</div>
                <div class="text-label-md font-bold uppercase tracking-widest">{metricLabel}</div>
              </div>
            )}
          </div>
          
          <div class="space-y-4 translate-y-12">
            <div class="bg-brand-blue-container p-8 rounded-xl text-on-brand-blue-container">
              {iconName && (
                <span class="material-symbols-outlined text-4xl mb-4">{iconName}</span>
              )}
              <div class="text-title-lg font-bold leading-tight">{iconTitle}</div>
            </div>
            
            {secondaryMediaUrl && (
              <div class="aspect-[3/4] rounded-xl overflow-hidden shadow-lg">
                <img alt="" class="w-full h-full object-cover" src={secondaryMediaUrl} />
              </div>
            )}
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style is:global>
  .accent-underline::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 96px;
    height: 8px;
    background-color: var(--brand-red, #bb0014);
    border-radius: 9999px;
  }
</style>
<script>
  // Client-side code (runs strictly in the browser console)
  const target = document.getElementById('debug-target');
  
  if (target) {
    // This prints to your Browser Developer Tools Inspector console!
    console.log("Browser side read:", target.dataset.rawContent);
  }
</script>