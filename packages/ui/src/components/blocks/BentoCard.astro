---
interface Props {
  colSpan?: string;
  cardBgStyle?: string;
  textColor?: string;
  icon?: string;
  iconColor?: string;
  title?: string;
  description?: string;
}

const {
  colSpan = 'md:col-span-1',
  cardBgStyle = 'bg-surface-container-lowest',
  textColor = 'text-on-surface',
  icon = '',
  iconColor = 'text-brand-blue',
  title = '',
  description = '',
} = Astro.props;

const cardClasses = `${colSpan} ${cardBgStyle} text-${textColor} p-8 md:p-10 rounded-[2rem] flex flex-col justify-between transition-transform hover:scale-[1.01]`;
---

<div class={cardClasses}>
  <div>
    {icon && (
      <span class={`material-symbols-outlined text-4xl md:text-5xl mb-6 text-${iconColor}`} data-icon={icon}>
        {icon}
      </span>
    )}

    {title && (
      <h3 class="text-2xl md:text-3xl font-bold mb-4">
        {title}
      </h3>
    )}

    {description && (
      <p class="text-lg opacity-90 mb-6">
        {description}
      </p>
    )}
  </div>

  <div class="mt-auto">
    <slot />
  </div>
</div>
<style is:global>
  /* Bento Card Custom List */
  .wp-block-list.is-style-bento-list {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding: 0;
    list-style-type: none;
    font-size: 1rem;
    opacity: 0.9;
  }
  .wp-block-list.is-style-bento-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  /* Checkmark List Style */
  .wp-block-list.is-style-checkmark-list {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding: 0;
    list-style-type: none;
  }
  .wp-block-list.is-style-checkmark-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.125rem;
    font-weight: 500;
  }

  /* Custom Button Link Styling */
  .wp-block-button.is-style-brand-primary .wp-block-button__link {
    display: inline-block;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    font-weight: 700;
    text-decoration: none;
    transition: all 150ms ease-in-out;
  }
</style>