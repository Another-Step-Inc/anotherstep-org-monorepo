---
interface Props {
    title: string;
    subtitle: string;
    buttonText: string;
    buttonLink: string;
    bgImage: string;
}

const { title, subtitle, buttonText, buttonLink, bgImage } = Astro.props;
---

<section class="relative h-[80vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img 
            src={bgImage} 
            alt=""
            class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-[#232020]/60"></div>
    </div>
    <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl">
            <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-tight">
                {title}
            </h1>
            <p class="text-xl text-white/90 mb-10 leading-relaxed max-w-2xl">
                {subtitle}
            </p>
            <div class="flex flex-wrap gap-4">
                <a 
                    href={buttonLink} 
                    class="bg-[#F9EF21] text-[#232020] px-10 py-4 rounded-full font-bold text-lg hover:bg-yellow-400 transition-all transform hover:scale-105 shadow-lg"
                >
                {buttonText} &rarr;
                </a>
                <a 
                    href="#services" 
                    class="bg-white/10 backdrop-blur-md text-white border-2 border-white/30 px-10 py-4 rounded-full font-bold text-lg hover:bg-white/20 transition-all"
                >
                Our Services
                </a>
            </div>
        </div>
    </div>
</section>