---
interface Props {
    title: string;
    subtitle: string;
    buttonText: string;
    buttonLink: string;
    bgImage: string;
}

const { title, subtitle, buttonText, buttonLink, bgImage } = Astro.props;
---

<section class="px-4 py-8 md:px-8">
  <div class="max-w-7xl mx-auto overflow-hidden rounded-3xl bg-gradient-to-br from-[#003366] to-[#004a94] shadow-xl">
    <div class="flex flex-col md:flex-row items-center">
      
      <div class="p-8 md:p-16 md:w-1/2 text-white">
        <span class="inline-block px-3 py-1 mb-4 text-xs font-semibold tracking-wider uppercase bg-yellow-400 text-blue-900 rounded-full">
          Established 1992
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight mb-6">
          {title}
        </h1>
        <p class="text-lg text-blue-50 mb-8 leading-relaxed">
            {subtitle}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/services" class="bg-yellow-400 text-blue-900 px-8 py-3 rounded-xl font-bold hover:bg-yellow-300 transition-all hover:scale-105">
            Our Services
          </a>
          <a href=`${buttonLink}` class="bg-white/10 backdrop-blur-sm border border-white/20 px-8 py-3 rounded-xl font-bold hover:bg-white/20 transition-all">
            {buttonText}
          </a>
        </div>
      </div>

      <div class="md:w-1/2 w-full h-64 md:h-[500px] relative">
        <img 
          src=`${bgImage}` 
          alt=`${title}` 
          class="absolute inset-0 w-full h-full rounded-3xl object-cover"
        />
        <div class="absolute inset-0 bg-blue-900/10"></div>
      </div>

    </div>
  </div>
</section>