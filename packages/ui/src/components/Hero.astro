---

const { 
  content, 
  layoutType, 
  imageDecoration, 
  hasBadge, 
  badgeText,
  badgeStyle, 
  quoteText, 
  statsNumber, 
  statsText, 
  extraDivText,
  title,
  paragraph,
  imageSrc,
  btn1Text,
  btn1Url,
  btn2Text,
  btn2Url  
} = Astro.props;

const badgeStyles = {
  'pill-yellow': 'inline-block bg-brand-yellow rounded-full px-4 py-1 mb-6 tracking-wide',
  'text-blue': 'block text-brand-blue mb-4 tracking-widest',
  'pill-blue': 'bg-brand-blue'
}

const activeBadgeClass = badgeStyles[badgeStyle];
---

<section class={`relative overflow-hidden ${layoutType === 'background' ? 'min-h-[85vh] flex items-center py-12' : 'py-24 md:py-32'}`}>
  {/*Quote bubble decorative element -->*/}
  {imageDecoration === 'quote-bubble' && quoteText && (
    <div class="absolute top-0 right-0 w-1/3 h-full bg-brand-blue-container/5 -skew-x-12 transform translate-x-1/2"></div>
  )}
  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    {/* If Background layout style, render the following */}
    {layoutType === 'background' && (
      <div class="absolute inset-0 z-0">
        <img
          alt=""
          class="w-full h-full object-cover"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCLgv_VaEzZoo5BJZmBcaXFxYVWxLZZtrB7wKAJYF7JDnVbirgJ-sWrA8AM4DB24qmtmUIm6wl3zVoc1IUI91d_mHIv4a67U8g6zjMPf2NJRu48HRDEqKXEskFPW9C0v3_djp5T5dkcD-ssIs4wAx_V7s1-m3MgsyQ5UqXS6jh1gmmXxq194gCTeMl7XaqUzfS4RyEj0xjg6_vK6mCJgNvL_jFWMUPbVSFsPOpVvzZCi2TjhohwVsWvqYeix8lRR7r_duQ7adQ3ZKo"
        />
        <div
          class="absolute inset-0 bg-gradient-to-r from-surface via-surface/60 to-transparent"
        >
        </div>
      </div>
    )}
    <div class={`${layoutType === 'background' ? 'relative z-10 md:grid-cols-2' : 'lg:grid-cols-12'} max-w-7xl mx-auto px-8 grid grid-cols-1 gap-12 items-center`}>
      <div class={layoutType === 'background' ? 'max-w-xl' : 'lg:col-span-7 space-y-8'}>
          {hasBadge && badgeText && (
            <span class={`${activeBadgeClass} text-sm font-bold uppercase`}>
              {badgeText}
            </span>
          )}

          {title && (
            <h1 class={`${badgeStyle === 'text-blue' ? 'text-on-surface mb-8' : 'text-brand-blue'} text-[42pt] font-black leading-tight tracking-tight`} set:html={title} />
          )}

          {paragraph && (
            <p class="text-[16pt] text-on-surface-variant font-normal leading-relaxed" set:html={paragraph} />
          )}

          {(btn1Text || btn2Text) && (
            <div class="flex flex-col sm:flex-row gap-4 pt-2">
              {btn1Text && (
                <a href={btn1Url || '#'} class="inline-flex items-center justify-center bg-brand-blue text-white px-10 py-4 rounded-full font-bold shadow-lg" set:html={btn1Text} />
              )}
              {btn2Text && (
                <a href={btn2Url || '#'} class="inline-flex items-center justify-center bg-surface-container-lowest text-brand-blue px-10 py-4 rounded-full font-bold hover:bg-surface-container-high transition-all duration-200 min-h-[56px]" set:html={btn2Text} />
              )}
            </div>
          )}

          {/* Layout Accent Information Item Block */}
          {imageDecoration === 'extra-text-div' && extraDivText && (
            <div class="flex flex-wrap gap-4 pt-4">
              <div class="flex items-center gap-3 bg-surface-container-high px-6 py-4 rounded-xl">
                <span class="material-symbols-outlined text-brand-dark-yellow text-3xl" style="font-variation-settings: 'FILL' 1;">
                  verified
                </span>
                <span class="text-label-md font-bold text-on-surface uppercase tracking-wider">
                  {extraDivText}
                </span>
              </div>
            </div>
          )}
      </div>

    {/* Split Layout Only */}
    {layoutType !== 'background' && imageSrc && (
      <div class="lg:col-span-5 relative">
        {/* Underlay structural backgrounds */}
        {imageDecoration === 'yellow-box' && <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-brand-yellow rounded-xl -z-10"></div>}
        {imageDecoration === 'extra-text-div' && <div class="absolute -inset-4 bg-brand-yellow/10 rounded-[2rem] -rotate-2 group-hover:rotate-0 transition-transform duration-500"></div>}

        {/* Dynamic Canvas Image Layout Frame */}
        <div class={`relative overflow-hidden shadow-2xl aspect-square 
          ${['bubble-text', 'yellow-box', 'extra-text-div'].includes(imageDecoration) ? 'w-95 h-95 rounded-[3rem] transform rotate-3' : ''}
          ${['quote-bubble'].includes(imageDecoration) ? 'rounded-xl organic-shadow transform rotate-3 scale-105 border-[8px] border-surface-container-lowest': ''}
          ${['gradient-overlay', 'organic-blur', 'none'].includes(imageDecoration) ? 'w-95 h-95 rounded-[3rem]' : ''}`}
        >
          <img src={imageSrc} class="w-full h-full object-cover" alt={title} />

          {/* Layout Aspect Mask Overlay Layer */}
          {imageDecoration === 'gradient-overlay' && <div class="absolute inset-0 bg-gradient-to-t from-brand-blue/40 to-transparent pointer-events-none"></div>}
        </div>

        {/* Absolute floating detail widgets over image edges */}
        {imageDecoration === 'bubble-text' && statsNumber && (
          <div class="absolute -bottom-3 left-1 w-2/5 h-auto bg-white p-6 rounded-2xl shadow-xl flex flex-col justify-center z-20">
            <span class="text-brand-red font-black text-2xl block leading-none mb-1">{statsNumber}</span>
            <p class="text-xs font-semibold text-gray-500 leading-tight">{statsText}</p>
          </div>
        )}

        {/* Quote bubble in corner of hero image */}
        {imageDecoration === 'quote-bubble' && quoteText && (
          <div class="absolute -bottom-6 -left-6 bg-brand-dark-yellow text-on-brand-yellow p-6 rounded-xl shadow-xl max-w-[240px] z-20">
            <p class="font-bold text-base italic leading-snug">{quoteText}</p>
          </div>
        )}

        {imageDecoration === 'organic-blur' && (
          <>
            <div class="absolute -bottom-8 -left-8 w-32 h-32 bg-purple-400 rounded-full mix-blend-multiply opacity-20 blur-xl -z-10"></div>
            <div class="absolute -top-8 -right-8 w-48 h-48 bg-yellow-400 rounded-full mix-blend-multiply opacity-10 blur-2xl -z-10"></div>
          </>
        )}
    </div>
  )}
  </div>
</section>

<style is:global>
    /* This ensures WordPress classes like .has-text-align-center work */
    .prose .has-text-align-center { text-align: center; }
    .prose .has-text-align-right { text-align: right; }
</style>