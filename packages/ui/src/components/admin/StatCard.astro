---
import Icon from './Icon.astro';

interface Props {
  label: string;
  value: number | string;
  detail: string;
  icon: string;
  tone?: 'blue' | 'violet' | 'amber' | 'green' | 'rose';
}
const { label, value, detail, icon, tone = 'blue' } = Astro.props;
---
<article class="stat-card">
  <div class="stat-card-top"><span>{label}</span><span class:list={['stat-icon', `tone-${tone}`]}><Icon name={icon} /></span></div>
  <div class="stat-value">{value}</div>
  <div class="stat-detail">{detail}</div>
</article>
