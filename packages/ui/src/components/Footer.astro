---
// components/Footer.astro
import { Image } from 'astro:assets';
import logoReg from '../assets/another_step_logo.png';
import accessibilityIcon from '../assets/accessibility-svgrepo-com.svg?raw'

interface MenuItem {
  label: string;
  path: string;
}

const WP_URL = import.meta.env.WP_GRAPHQL_URL || 'http://host.docker.internal:8050/graphql';

async function fetchMenuItems(menuSlug: string): Promise<MenuItem[]> {
  try {
    const response = await fetch(WP_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        query: `
          query GetMenu {
            menu(id: "${menuSlug}", idType: SLUG) {
              id
              menuItems(first: 100) {
                nodes {
                  id
                  label
                  path
                  parentId
                }
              }
            }
          }
        `,
      }),
    });

    const result = await response.json();

    if (!result.data?.menu?.menuItems?.nodes) {
      console.warn(`Menu data not found for ${menuSlug}`);
      return [];
    }

    return result.data.menu.menuItems.nodes
      .filter((item: any) => !item.parentId)
      .map((item: any) => ({
        label: item.label,
        path: item.path,
      }));
  } catch (error) {
    console.error(`Failed to fetch ${menuSlug} menu from WordPress:`, error);
    return [];
  }
}

const quickLinks = await fetchMenuItems('quick-links');
const ourServices = await fetchMenuItems('our-services');
const date = new Date;
const year = date.getFullYear();
console.log(date);
---
