---
import { Image } from 'astro:assets';
import logoReg from '../assets/another_step_logo.png';

interface MenuItem {
  title: string;
  url: string;
  children?: MenuItem[];
}

const WP_URL = import.meta.env.WP_GRAPHQL_URL || 'http://host.docker.internal:8050/graphql';

async function fetchMenuData(): Promise<MenuItem[]> {
  try {
    const response = await fetch(WP_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        query: `
          query GetMenu {
            menu(id: "main-navigation", idType: SLUG) {
              id
              name
              menuItems(first: 100) {
                nodes {
                  id
                  label
                  path
                  parentId
                  childItems {
                    nodes {
                      id
                      label
                      path
                    }
                  }
                }
              }
            }
          }
        `,
      }),
    });

    const result = await response.json();

    if (!result.data?.menu?.menuItems?.nodes) {
      console.warn('Menu data not found in WordPress response');
      return getFallbackMenu();
    }

    const items = result.data.menu.menuItems.nodes;

    // Filter only top-level items (no parentId)
    return items
      .filter((item: any) => !item.parentId)
      .map((item: any) => ({
        title: item.label,
        url: item.path,
        children: item.childItems?.nodes?.map((child: any) => ({
          title: child.label,
          url: child.path,
        })) || [],
      }));
  } catch (error) {
    console.error('Failed to fetch menu from WordPress:', error);
    return getFallbackMenu();
  }
}

function getFallbackMenu(): MenuItem[] {
  return [
    {
      title: 'About Us',
      url: '/about-us',
      children: [
        { title: 'Sector News', url: '/sector-news' },
        { title: 'Gallery', url: '#gallery' },
      ]
    },
    { title: 'Advocacy', url: '/advocacy' },
    {
      title: 'Services',
      url: '/services',
      children: [
        { title: 'Community Habilitation', url: '#community-habilitation' },
        { title: 'Day Habilitation', url: '#day-habilitation' },
        { title: 'Supported Employment', url: '#supported-employment' },
        { title: 'Respite', url: '#respite' },
        { title: 'Residences/Supervised Living', url: '#residences-and-supervised-living' }
      ]
    },
    {
      title: 'Store',
      url: '/store',
      children: [
        { title: 'All Products', url: '/store' },
        { title: 'Apparel', url: '/store/category/apparel' },
        { title: 'Donation Gifts', url: '/store/category/gifts' }
      ]
    },
    {
      title: 'Support Us',
      url: '#support-us',
      children: [
        { title: 'Donations', url: '/donation' },
        { title: 'Crayola Flowers Fundraiser', url: '/crayola-flowers-fundraiser' }
      ]
    },
    { title: 'Contact Us', url: '/contact' },
  ];
}

const menuData = await fetchMenuData();
const { isStore = false } = Astro.props;
---
<div class="bg-brand-blue text-white py-2 text-sm hidden md:block">
  <div class="container mx-auto px-4 flex justify-end items-center py-2">
    <div class="flex items-center space-x-4">
      
      <span class="text-xs font-bold border-r pr-4 flex items-center gap-2">
        <i class="fa fa-phone text-[10px]"></i>
        (845)-268-8200
      </span>

      <span class="text-xs font-medium tracking-tight">
        Available Mon-Fri, 9am - 5pm
      </span>
      
    </div>
  </div>
</div>

<header class="site-header sticky top-0 bg-white py-4 shadow-md z-50">
  <div class="container mx-auto px-4 flex items-center justify-between">
    
    <div class="site-branding flex flex-row items-center">
      <Image src={logoReg} alt="Another Step Logo" class="h-16 w-auto" />
      <p class="site-title font-bold text-md text-brand-blue">
        <a href="/" rel="home">Another Step</a>
      </p>
    </div>

    <nav class="main-navigation hidden md:block flex-grow">
      <ul class="flex justify-center space-x-1 lg:space-x-2">
        {menuData.map((item) => (
          <li class="menu-item group relative">
            <a 
              href={item.url} 
              class="text-[#232020] hover:text-[#F9EF21] font-medium transition-colors duration-300 flex items-center px-4 py-2"
            >
              {item.title}
              {item.children && item.children.length > 0 && (
                <span class="ml-2 text-[10px] transition-transform duration-300 group-hover:rotate-180">▼</span>
              )}
            </a>

            {item.children && item.children.length > 0 && (
              <ul class="sub-menu absolute hidden group-hover:block bg-white shadow-xl rounded-md mt-0 py-2 min-w-[200px] z-50 left-0 border border-gray-100">
                {item.children.map((child) => (
                  <li>
                    <a 
                      href={child.url} 
                      class="text-[#232020] hover:text-[#F9EF21] hover:bg-gray-50 font-medium transition-colors duration-300 flex items-center px-4 py-2"
                    >
                      {child.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden md:flex items-center space-x-4">
      <a 
        href="/donation" 
        class="bg-brand-blue text-white px-8 py-3 rounded-full font-semibold hover:bg-brand-blue-400 transition-colors duration-300 shadow-sm"
      >
        Donate Now &rarr;
      </a>
    </div>

    <button id="mobile-menu-toggle" class="md:hidden p-2 text-[#232020]">
      <div class="space-y-1.5">
        <span class="block w-6 h-0.5 bg-current"></span>
        <span class="block w-6 h-0.5 bg-current"></span>
        <span class="block w-6 h-0.5 bg-current"></span>
      </div>
    </button>
  </div>

  <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-white shadow-2xl py-8 md:hidden border-t">
    <ul class="flex flex-col items-center space-y-4">
      {menuData.map((item) => (
        <li class="w-full text-center">
          <a href={item.url} class="text-lg font-bold text-[#232020]">{item.title}</a>
          {item.children && item.children.length > 0 && (
             <div class="flex flex-col space-y-2 mt-2 bg-gray-50 py-2">
                {item.children.map(child => (
                  <a href={child.url} class="text-sm text-gray-600">{child.title}</a>
                ))}
             </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</header>
{isStore && (
<div class="w-full bg-[#0E75BC] text-white shadow-lg border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14">
        
        <div class="flex items-center gap-8">
          <a href="/products?cat=clothing" class="group flex items-center gap-2">
            <span class="text-xs font-black uppercase tracking-[0.2em] group-hover:text-[#F9EF21] transition-colors">Clothing</span>
          </a>
          <a href="/products?cat=hats" class="group flex items-center gap-2">
            <span class="text-xs font-black uppercase tracking-[0.2em] group-hover:text-[#F9EF21] transition-colors">Hats</span>
          </a>
          <div class="h-6 w-[1px] bg-white/20 hidden md:block"></div>
          <a href="/impact" class="text-xs font-black uppercase tracking-[0.2em] text-[#F9EF21] hover:brightness-110">
            Our Impact
          </a>
        </div>

        <div class="flex items-center gap-6">
          <form action="/search" class="hidden sm:block relative">
            <input 
              type="text" 
              placeholder="Search Store..." 
              class="bg-white/10 border border-white/20 rounded-full py-1 px-4 text-xs placeholder:text-white/50 focus:outline-none focus:bg-white focus:text-[#232020] transition-all w-48"
            />
          </form>
          
          <a href="/cart" class="flex items-center gap-2 group">
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span class="absolute -top-1 -right-1 bg-[#EC1F28] text-white text-[9px] font-black w-4 h-4 rounded-full flex items-center justify-center shadow-md">
                0
              </span>
            </div>
            <span class="hidden md:inline text-[10px] font-black uppercase tracking-widest">Cart</span>
          </a>
        </div>

      </div>
    </div>
  </div>
  )} 

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  function initStickyHeader() {
    const stickyHeader = document.querySelector('.sticky-header');
    const topBar = document.querySelector('.top-bar') as HTMLElement;
    
    if (!stickyHeader) return;

    // Get dynamic height of top bar (usually ~40px)
    const topBarHeight = topBar ? topBar.offsetHeight : 0;
    let isScrolled = false;

    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;

      if (currentScroll > topBarHeight && !isScrolled) {
        stickyHeader.classList.add('scrolled');
        isScrolled = true;
      } else if (currentScroll <= topBarHeight && isScrolled) {
        stickyHeader.classList.remove('scrolled');
        isScrolled = false;
      }
    });
  }

  // Initialize on load
  initStickyHeader();
  
  // Re-init if using Astro View Transitions
  document.addEventListener('astro:after-swap', initStickyHeader);
</script>