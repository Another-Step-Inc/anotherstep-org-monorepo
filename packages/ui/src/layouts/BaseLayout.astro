---
// packages/ui/srx/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import PointerTrail from '../components/PointerTrail.astro';

interface Props {
    title: string;
    description?: string;
    isStore?: boolean;
    children?: any;
}

const { title, description = "Another Step, Inc. - Partnering with People to Create the Lives They Choose", isStore = false} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | Another Step, Inc.</title>
        <meta name="description" content={description} />
    </head>
    <body class:list={["min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans", { "is-store-view": isStore }]}>
        <Header isStore={isStore} />
        <main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <slot />
        </main>
        <PointerTrail />    
    </body>
</html>